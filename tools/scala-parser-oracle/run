#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

if [[ -f "${HOME}/.sdkman/bin/sdkman-init.sh" ]]; then
  # shellcheck disable=SC1091
  set +u
  source "${HOME}/.sdkman/bin/sdkman-init.sh"
  set -u
fi

temporary_source=''
sbt_output=''
cleanup() {
  if [[ -n "${temporary_source}" ]]; then
    rm -f -- "${temporary_source}"
  fi
  if [[ -n "${sbt_output}" ]]; then
    rm -f -- "${sbt_output}"
  fi
}
trap cleanup EXIT

mode_args=()
batch_manifest=''
if [[ "$#" -eq 2 && "$1" == "--batch" ]]; then
  batch_manifest=$2
elif [[ "$#" -eq 3 && "$1" == "--mode" && ("$2" == "pattern" || "$2" == "block" || "$2" == "block-erased" || "$2" == "compilation" || "$2" == "compilation-capture") ]]; then
  mode_args=("$1" "$2")
  shift 2
elif [[ "$#" -gt 1 ]]; then
  echo "usage: $0 [--mode pattern|block|block-erased|compilation|compilation-capture] [source-file] | --batch manifest" >&2
  exit 2
fi

if [[ -n "${batch_manifest}" ]]; then
  if [[ "${batch_manifest}" != /* ]]; then
    batch_manifest="$(cd "$(dirname "${batch_manifest}")" && pwd)/$(basename "${batch_manifest}")"
  fi
  source_path=''
elif [[ "$#" -eq 1 ]]; then
  source_path=$1
  if [[ "${source_path}" != /* ]]; then
    source_path="$(cd "$(dirname "${source_path}")" && pwd)/$(basename "${source_path}")"
  fi
else
  temporary_source=$(mktemp "${TMPDIR:-/tmp}/scala-parser-oracle.XXXXXX.scala")
  cat >"${temporary_source}"
  source_path=${temporary_source}
fi

if ! command -v sbt >/dev/null 2>&1; then
  echo "scala-parser-oracle requires sbt 2.0.9 and Scala 3.9.0" >&2
  exit 127
fi

cd "${script_dir}"
sbt_output=$(mktemp "${TMPDIR:-/tmp}/scala-parser-oracle.XXXXXX.log")
if [[ -n "${batch_manifest}" ]]; then
  run_command="run --batch ${batch_manifest}"
else
  run_command="run"
fi
if [[ -z "${batch_manifest}" && "${#mode_args[@]}" -eq 2 ]]; then
  run_command+=" ${mode_args[*]}"
fi
if [[ -z "${batch_manifest}" ]]; then
  run_command+=" ${source_path}"
fi
if ! sbt --server --error "${run_command}" >"${sbt_output}" 2>&1; then
  cat "${sbt_output}" >&2
  exit 1
fi

if [[ -n "${batch_manifest}" ]]; then
  # SBT can emit JSON-looking lines of its own. Only the explicit batch marker
  # identifies records written by the parser oracle.
  json=$(grep -a '^__DOTTY_PARSER_ORACLE_RECORD__' "${sbt_output}" | sed 's/^__DOTTY_PARSER_ORACLE_RECORD__//' || true)
else
  json=$(grep -a '^{"kind":' "${sbt_output}" | tail -n 1 || true)
fi
if [[ -z "${json}" ]]; then
  cat "${sbt_output}" >&2
  echo "scala-parser-oracle did not produce JSON" >&2
  exit 1
fi
printf '%s\n' "${json}"
