#!/usr/bin/env python3
"""Measure JdkClassPath startup and lookup cost in fresh Linux processes."""

import argparse
import datetime as dt
import json
import hashlib
import io
import resource
import tempfile
import zipfile
import os
from pathlib import Path
import platform
import re
import shutil
import statistics
import subprocess
import sys


ROOT = Path(__file__).resolve().parents[2]
PROC_STATUS = Path("/proc/self/status")


def percentile95(values):
    ordered = sorted(values)
    return ordered[max(0, (95 * len(ordered) + 99) // 100 - 1)]


def quantiles(values):
    return {"median": statistics.median(values), "p95": percentile95(values)}


def run_checked(command, *, env=None):
    result = subprocess.run(command, cwd=ROOT, env=env, text=True, capture_output=True)
    if result.returncode:
        raise RuntimeError(
            f"command failed ({result.returncode}): {' '.join(map(str, command))}\n"
            f"{result.stderr.strip()}"
        )
    return result


def build_driver(env=None):
    result = run_checked([
        "cargo",
        "build",
        "--release",
        "--locked",
        "--message-format=json-render-diagnostics",
        "-p",
        "dotty-classloader",
        "--example",
        "jdk_classpath_benchmark",
    ], env=env)
    for line in result.stdout.splitlines():
        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            continue
        target = message.get("target", {})
        if (
            message.get("reason") == "compiler-artifact"
            and target.get("name") == "jdk_classpath_benchmark"
            and "example" in target.get("kind", [])
            and message.get("executable")
        ):
            return Path(message["executable"]).resolve()
    raise RuntimeError("Cargo did not report the jdk_classpath_benchmark executable artifact")


def smoke(binary):
    result = run_checked([binary, "--smoke"])
    report = json.loads(result.stdout)
    expected = {
        "smoke": True,
        "positive_classes": 2,
        "negative_lookup": True,
        "package_queries": True,
    }
    if any(report.get(key) != value for key, value in expected.items()):
        raise RuntimeError(f"unexpected smoke output: {result.stdout.strip()}")
    if not isinstance(report["peak_rss_kib"], int) or report["peak_rss_kib"] <= 0:
        raise RuntimeError(f"smoke output has no positive VmHWM RSS: {result.stdout.strip()}")
    if not isinstance(report["fd_count_after_init"], int) or report["fd_count_after_init"] <= 0:
        raise RuntimeError(f"smoke output has no positive open file descriptor count: {result.stdout.strip()}")
    print(json.dumps(report, sort_keys=True))


def metadata_smoke(binary):
    fixture = ROOT / "crates/dotty-classloader/tests/fixtures/jdk_module_catalog"
    with tempfile.TemporaryDirectory(prefix="dotty-metadata-smoke-") as temporary:
        for name in ("fixture.alpha", "fixture.beta", "fixture.minimal"):
            data = io.BytesIO()
            with zipfile.ZipFile(data, "w", compression=zipfile.ZIP_STORED) as archive:
                archive.writestr("classes/module-info.class", (fixture / f"{name}-module-info.class").read_bytes())
            (Path(temporary) / f"{name}.jmod").write_bytes(b"JM\x01\x00" + data.getvalue())
        result = run_checked([binary, "--metadata-smoke", "--jmods", temporary])
    if json.loads(result.stdout) != {"metadata_smoke": True, "module_count": 3}:
        raise RuntimeError("unexpected metadata smoke output")
    print(result.stdout.strip())


def jdk_path(args):
    if args.jmods:
        path = Path(args.jmods).expanduser().resolve()
    else:
        java_home = os.environ.get("JAVA_HOME")
        if not java_home:
            raise RuntimeError("provide --jmods PATH or set JAVA_HOME to a JDK 21 installation")
        path = (Path(java_home).expanduser() / "jmods").resolve()
    if not path.is_dir():
        raise RuntimeError(
            f"JMOD directory is unavailable: {path}; install/provide a JDK 21 and pass --jmods PATH or set JAVA_HOME"
        )
    modules = sorted(path.glob("*.jmod"))
    if not modules:
        raise RuntimeError(f"no .jmod files found in {path}; expected a JDK jmods directory")
    return path, modules


def environment(path, modules, explicit_jmods):
    if explicit_jmods:
        java = path.resolve().parent / "bin/java"
    elif os.environ.get("JAVA_HOME"):
        java = Path(os.environ["JAVA_HOME"]) / "bin/java"
    else:
        java = shutil.which("java")
        if java is None:
            raise RuntimeError("could not find java; set JAVA_HOME to a JDK 21 installation")
    if not Path(java).is_file():
        raise RuntimeError(f"JDK java executable is unavailable at {java}; provide a complete JDK 21 installation")
    java_version = subprocess.run(
        [str(java), "-XshowSettings:properties", "-version"], text=True, capture_output=True
    )
    version_output = java_version.stderr or java_version.stdout
    if java_version.returncode != 0:
        raise RuntimeError("could not run java -version; provide a JDK 21 installation and set JAVA_HOME")
    release = re.search(r"^\s*java\.version\s*=\s*(\S+)", version_output, re.MULTILINE)
    vendor = re.search(r"^\s*java\.vendor\s*=\s*(.+)$", version_output, re.MULTILINE)
    runtime = re.search(r"^\s*java\.runtime\.version\s*=\s*(\S+)", version_output, re.MULTILINE)
    release_value = release.group(1) if release else ""
    if not release_value.startswith("21.") and release_value != "21":
        raise RuntimeError(
            f"expected JDK 21, got java.version {release_value or 'unknown'}"
        )
    return {
        "captured_at_utc": dt.datetime.now(dt.timezone.utc).isoformat(),
        "os": platform.platform(),
        "kernel": run_checked(["uname", "-a"]).stdout.strip(),
        "cpu": cpu_model(),
        "logical_cpu_count": os.cpu_count(),
        "memory_total_kib": memory_total_kib(),
        "memory_cgroup_limit_bytes": memory_cgroup_limit_bytes(),
        "jdk_distribution": vendor.group(1).strip() if vendor else "unknown",
        "jdk_version": runtime.group(1) if runtime else release_value,
        "jmods_count": len(modules),
        "jmods_total_bytes": sum(module.stat().st_size for module in modules),
        "jmods_dir_label": "provided-jmods",
        "rustc": run_checked(["rustc", "-Vv"]).stdout.strip(),
        "cargo": run_checked(["cargo", "-V"]).stdout.strip(),
        "profile": "release",
        "open_fd_limit_soft_hard": list(resource.getrlimit(resource.RLIMIT_NOFILE)),
        "jmods_sha256": {module.name: hashlib.sha256(module.read_bytes()).hexdigest() for module in modules},
        "release_profile": {"opt_level": 3, "lto": False, "codegen_units": 16, "debug": False},
        "build_overrides": {key: value for key, value in os.environ.items() if key.startswith("CARGO_PROFILE_RELEASE_") or key in ("RUSTFLAGS", "CARGO_ENCODED_RUSTFLAGS")},
        "rss_method": "Linux /proc/self/status VmHWM high-water mark in KiB; read at end of the complete benchmark workload",
    }


def memory_total_kib():
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            if line.startswith("MemTotal:"):
                return int(line.split()[1])
    except OSError:
        pass
    return None


def memory_cgroup_limit_bytes():
    for candidate in (Path("/sys/fs/cgroup/memory.max"), Path("/sys/fs/cgroup/memory/memory.limit_in_bytes")):
        try:
            value = candidate.read_text().strip()
            if value != "max":
                limit = int(value)
                if limit < 2**60:
                    return limit
        except (OSError, ValueError):
            pass
    return None


def cpu_model():
    try:
        for line in Path("/proc/cpuinfo").read_text().splitlines():
            if line.startswith(("model name", "Hardware", "Processor")):
                return line.split(":", 1)[-1].strip()
    except OSError:
        pass
    return platform.processor() or platform.machine()


def run_samples(binary, path, count):
    samples = []
    for index in range(count):
        result = subprocess.run(
            [binary, "--jmods", str(path)],
            cwd=ROOT,
            text=True,
            capture_output=True,
        )
        if result.returncode:
            raise RuntimeError(
                f"sample {index + 1}/{count} failed ({result.returncode}):\n{result.stderr.strip()}"
            )
        measurements = json.loads(result.stdout)
        samples.append({
            "sample": index + 1,
            "rss_kib": measurements["peak_rss_kib"],
            "measurements": measurements,
        })
    return samples


def summarize(samples):
    init_ms = [sample["measurements"]["init_ns"] / 1_000_000 for sample in samples]
    rss = [sample["rss_kib"] for sample in samples]
    first_class = samples[0]["measurements"]["class_lookups"]
    classes = {}
    for index, first_row in enumerate(first_class):
        classes[first_row["class"]] = {
            "first_lookup_ms": quantiles([
                sample["measurements"]["class_lookups"][index]["first_lookup_ns"] / 1_000_000
                for sample in samples
            ]),
            "warm_lookup_ms_per_op": quantiles([
                sample["measurements"]["class_lookups"][index]["warm_total_ns"] /
                sample["measurements"]["class_lookups"][index]["warm_iterations"] / 1_000_000
                for sample in samples
            ]),
        }
    negative = {
        "first_lookup_ms": quantiles([
            sample["measurements"]["negative_lookup"]["first_lookup_ns"] / 1_000_000
            for sample in samples
        ]),
        "warm_lookup_ms_per_op": quantiles([
            sample["measurements"]["negative_lookup"]["warm_total_ns"] /
            sample["measurements"]["negative_lookup"]["warm_iterations"] / 1_000_000
            for sample in samples
        ]),
    }
    package_queries = {}
    for index, first_row in enumerate(samples[0]["measurements"]["package_lookups"]):
        package_queries[f"{first_row['query']}:{first_row['package']}"] = quantiles([
            sample["measurements"]["package_lookups"][index]["total_ns"] /
            sample["measurements"]["package_lookups"][index]["iterations"] / 1_000_000
            for sample in samples
        ])
    concurrent_lookups = {}
    for index, first_row in enumerate(samples[0]["measurements"].get("concurrent_lookups", [])):
        operation_count = (
            first_row["threads"] * first_row["iterations_per_thread"]
        )
        concurrent_lookups[f"{first_row['module']}:{first_row['class']}"] = quantiles([
            sample["measurements"]["concurrent_lookups"][index]["total_ns"] /
            operation_count / 1_000_000
            for sample in samples
        ])
    fd_counts = {
        key: quantiles([sample["measurements"][key] for sample in samples])
        for key in ("fd_count_after_init", "fd_count_after_workload")
        if key in samples[0]["measurements"]
    }
    return {
        "init_ms": quantiles(init_ms),
        "peak_rss_kib": quantiles(rss),
        "class_lookups": classes,
        "negative_lookup": negative,
        "package_lookup_ms_per_op": package_queries,
        "concurrent_lookup_ms_per_op": concurrent_lookups,
        "open_file_descriptors": fd_counts,
    }


RESOURCE_PHASES = ("before_init", "after_init", "after_first_catalogs", "after_calls", "after_drop_catalogs", "after_drop_paths")
MODULE_QUERIES = ("java.base", "java.net.http", "java.desktop", "dotty.missing.module")


def validate_metadata_sample(row, sessions, module_count):
    """Reject partial/mismatched samples before deriving any summary."""
    def integer(value, label, minimum=0):
        if type(value) is not int or value < minimum:
            raise RuntimeError(f"invalid metadata sample: {label} must be an integer >= {minimum}")

    if not isinstance(row, dict):
        raise RuntimeError("invalid metadata sample: expected an object")
    try:
        if row["sessions"] != sessions or row["module_count"] != module_count:
            raise RuntimeError("invalid metadata sample: session/module count differs from requested cohort")
        integer(row["sessions"], "sessions", 1)
        integer(row["module_count"], "module_count", 1)
        for key in ("init_ns", "catalog_string_bytes_per_session"):
            integer(row[key], key, 1)
        for key in ("init_per_session_ns", "first_catalog_per_session_ns"):
            if not isinstance(row[key], list) or len(row[key]) != sessions:
                raise RuntimeError(f"invalid metadata sample: {key} needs {sessions} entries")
            for value in row[key]:
                integer(value, key, 1)
        for phase in RESOURCE_PHASES:
            if set(row[phase]) != {"fd_count", "rss_kib", "peak_rss_kib"}:
                raise RuntimeError(f"invalid metadata sample: wrong resource fields at {phase}")
            for key, value in row[phase].items():
                integer(value, f"{phase}.{key}", 1)
        lookups = row["module_lookups"]
        if [lookup["module"] for lookup in lookups] != list(MODULE_QUERIES):
            raise RuntimeError("invalid metadata sample: wrong module query count/order")
        for lookup in lookups:
            if lookup["snapshot_iterations"] != 10_000 or lookup["fresh_iterations"] != 20:
                raise RuntimeError("invalid metadata sample: unexpected lookup iteration counts")
            for key in ("first_snapshot_lookup_ns", "snapshot_iterations", "snapshot_total_ns", "fresh_iterations", "fresh_total_ns"):
                integer(lookup[key], key, 1)
        if row["enumeration"]["iterations"] != 10_000:
            raise RuntimeError("invalid metadata sample: unexpected enumeration iteration count")
        for key in ("iterations", "total_ns"):
            integer(row["enumeration"][key], f"enumeration.{key}", 1)
        if [item["mode"] for item in row["concurrent"]] != ["shared_session", "independent_sessions"]:
            raise RuntimeError("invalid metadata sample: wrong concurrent scenario count/order")
        for item in row["concurrent"]:
            if item["threads"] != 4 or item["iterations_per_thread"] != 10:
                raise RuntimeError("invalid metadata sample: expected four concurrent workers with ten calls each")
            for key in ("threads", "iterations_per_thread", "total_ns"):
                integer(item[key], key, 1)
    except (KeyError, TypeError) as error:
        raise RuntimeError(f"invalid metadata sample: missing or malformed field {error}") from error


def summarize_metadata(samples):
    def metric(getter, scale=1):
        return quantiles([getter(row) / scale for row in samples])

    return {
        "init_ms": metric(lambda row: row["init_ns"], 1_000_000),
        "first_catalog_ms_per_session": metric(lambda row: sum(row["first_catalog_per_session_ns"]) / row["sessions"], 1_000_000),
        "first_catalog_session_0_ms": metric(lambda row: row["first_catalog_per_session_ns"][0], 1_000_000),
        "resources": {
            phase: {key: metric(lambda row: row[phase][key]) for key in ("fd_count", "rss_kib", "peak_rss_kib")}
            for phase in RESOURCE_PHASES
        },
        "resource_deltas": {
            "init_fd_count": metric(lambda row: row["after_init"]["fd_count"] - row["before_init"]["fd_count"]),
            "metadata_fd_count": metric(lambda row: row["after_calls"]["fd_count"] - row["after_init"]["fd_count"]),
            "held_catalog_rss_kib": metric(lambda row: row["after_first_catalogs"]["rss_kib"] - row["after_init"]["rss_kib"]),
        },
        "catalog_string_bytes_per_session": metric(lambda row: row["catalog_string_bytes_per_session"]),
        "module_lookups": {
            name: {
                "first_snapshot_lookup_ms": metric(lambda row: row["module_lookups"][index]["first_snapshot_lookup_ns"], 1_000_000),
                "snapshot_ms_per_op": metric(lambda row: row["module_lookups"][index]["snapshot_total_ns"] / row["module_lookups"][index]["snapshot_iterations"], 1_000_000),
                "fresh_catalog_and_get_ms_per_op": metric(lambda row: row["module_lookups"][index]["fresh_total_ns"] / row["module_lookups"][index]["fresh_iterations"], 1_000_000),
            } for index, name in enumerate(MODULE_QUERIES)
        },
        "snapshot_enumeration_ms_per_op": metric(lambda row: row["enumeration"]["total_ns"] / row["enumeration"]["iterations"], 1_000_000),
        "concurrent_amortized_ms_per_op": {
            mode: metric(lambda row: row["concurrent"][index]["total_ns"] / (row["concurrent"][index]["threads"] * row["concurrent"][index]["iterations_per_thread"]), 1_000_000)
            for index, mode in enumerate(("shared_session", "independent_sessions"))
        },
    }


def run_metadata_samples(binary, path, count, module_count):
    # Semantic/source checks run in their own process before any timed sample.
    preflight = run_checked([binary, "--metadata-check", "--jmods", str(path)])
    if json.loads(preflight.stdout) != {"metadata_check": True}:
        raise RuntimeError("metadata preflight did not confirm expected semantics")
    cohorts = {str(sessions): [] for sessions in (1, 2, 4)}
    # Interleave session counts to reduce time/order bias between comparable cohorts.
    for index in range(count):
        for sessions in (1, 2, 4):
            result = run_checked([binary, "--metadata", "--jmods", str(path), "--sessions", str(sessions)])
            row = json.loads(result.stdout)
            validate_metadata_sample(row, sessions, module_count)
            cohorts[str(sessions)].append({"sample": index + 1, "measurements": row})
    return {
        key: {"sample_count": count, "summary": summarize_metadata([sample["measurements"] for sample in samples]), "samples": samples}
        for key, samples in cohorts.items()
    }


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--jmods", help="path to a JDK 21 jmods directory (defaults to JAVA_HOME/jmods)")
    parser.add_argument("--samples", type=int, default=10, help="independent fresh-process runs (minimum 10)")
    parser.add_argument("--output", help="raw JSON destination (metadata and baseline have separate defaults)")
    parser.add_argument("--metadata", action="store_true", help="measure module catalog and 1/2/4 independent sessions")
    parser.add_argument("--smoke", action="store_true", help="run the tiny checked-in JMOD fixture without a JDK")
    parser.add_argument("--binary", help="use an already built release benchmark executable")
    parser.add_argument("--source-revision", default="unspecified", help="classloader source revision represented by the run")
    parser.add_argument("--purpose", default="measurement", help="short label describing the measurement cohort")
    args = parser.parse_args()

    try:
        if args.smoke:
            binary = Path(args.binary).expanduser().resolve() if args.binary else build_driver()
            smoke(binary)
            metadata_smoke(binary)
            return 0
        if args.samples < 10:
            raise RuntimeError("--samples must be at least 10 for a baseline run")
        path, modules = jdk_path(args)
        environment_info = environment(path, modules, bool(args.jmods))
        if not PROC_STATUS.is_file():
            raise RuntimeError("Linux /proc/self/status with VmHWM is required to measure peak RSS")
        binary = Path(args.binary).expanduser().resolve() if args.binary else build_driver()
        if not binary.is_file() or not os.access(binary, os.X_OK):
            raise RuntimeError(f"benchmark executable is unavailable or not executable: {binary}")
        results = None if args.metadata else run_samples(binary, path, args.samples)
        report = {
            "schema_version": 2 if args.metadata else 1,
            "binary_sha256": hashlib.sha256(binary.read_bytes()).hexdigest(),
            "purpose": args.purpose,
            "source_revision": args.source_revision,
            "sample_count": args.samples,
            "process_model": "each raw row is one independently launched release binary process; OS page cache is not flushed",
            "environment": environment_info,
            **({"cohorts": run_metadata_samples(binary, path, args.samples, len(modules))} if args.metadata else {"summary": summarize(results), "samples": results}),
        }
        output_name = args.output or ("docs/jdk-module-metadata-performance-raw.json" if args.metadata else "docs/jdk-classpath-performance-raw.json")
        output = (ROOT / output_name).resolve()
        output.parent.mkdir(parents=True, exist_ok=True)
        output.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
        print(f"wrote {args.samples} raw samples to {output_name}")
        summaries = {key: cohort["summary"] for key, cohort in report["cohorts"].items()} if args.metadata else report["summary"]
        print(json.dumps(summaries, sort_keys=True))
        return 0
    except (OSError, RuntimeError, json.JSONDecodeError) as error:
        print(f"jdk-classpath-benchmark: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
