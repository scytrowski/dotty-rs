report_field() {
    awk -F= -v wanted="$1" '
        {
            key = $1
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
            if (key == wanted) {
                value = substr($0, index($0, "=") + 1)
                sub(/[[:space:]]+\(delta=.*/, "", value)
                print value
                exit
            }
        }
    ' "$tmp_dir/first.report"
}

