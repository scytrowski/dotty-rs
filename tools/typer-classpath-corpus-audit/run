#!/usr/bin/env bash
set -euo pipefail

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(CDPATH= cd -- "$script_dir/../.." && pwd)"
scala_root="${SCALA39_ROOT:?set SCALA39_ROOT to the pinned Scala 3.9.0 checkout}"
java_home="${JAVA_HOME:?set JAVA_HOME to the JDK used for this audit}"
jdk_release="${SCALA39_JDK_RELEASE:?set SCALA39_JDK_RELEASE to the JDK feature version}"
coursier_maven_root="${COURSIER_MAVEN_ROOT:-${HOME}/.cache/coursier/v1/https/repo1.maven.org/maven2}"

if [[ ! -d "$java_home/jmods" || ! -f "$java_home/release" ]]; then
    printf 'JAVA_HOME must contain a release file and a jmods directory: %s\n' "$java_home" >&2
    exit 1
fi
jdk_version="$(sed -n 's/^JAVA_VERSION="\([^"]*\)".*/\1/p' "$java_home/release")"
jdk_feature="${jdk_version%%.*}"
if [[ "$jdk_feature" != "$jdk_release" ]]; then
    printf 'JAVA_HOME is Java %s; SCALA39_JDK_RELEASE is %s\n' "$jdk_feature" "$jdk_release" >&2
    exit 1
fi

revision="777528f19a58e794c9954a42f433373472ec57f8"
actual_revision="$(git -C "$scala_root" rev-parse HEAD)"
if [[ "$actual_revision" != "$revision" ]]; then
    printf 'SCALA39_ROOT revision is %s; expected %s\n' "$actual_revision" "$revision" >&2
    exit 1
fi

scala_jars=(
    "$coursier_maven_root/org/scala-lang/scala3-library_3/3.9.0/scala3-library_3-3.9.0.jar"
    "$coursier_maven_root/org/scala-lang/scala-library/3.9.0/scala-library-3.9.0.jar"
    "$coursier_maven_root/org/scala-lang/scala3-compiler_3/3.9.0/scala3-compiler_3-3.9.0.jar"
    "$coursier_maven_root/org/scala-lang/tasty-core_3/3.9.0/tasty-core_3-3.9.0.jar"
    "$coursier_maven_root/org/scala-lang/scala3-interfaces/3.9.0/scala3-interfaces-3.9.0.jar"
    "$coursier_maven_root/org/scala-lang/modules/scala-asm/9.9.0-scala-1/scala-asm-9.9.0-scala-1.jar"
    "$coursier_maven_root/org/scala-sbt/compiler-interface/1.12.0/compiler-interface-1.12.0.jar"
    "$coursier_maven_root/org/scala-sbt/util-interface/1.11.5/util-interface-1.11.5.jar"
)
for jar in "${scala_jars[@]}"; do
    if [[ ! -f "$jar" ]]; then
        printf 'missing Scala runtime artifact: %s\n' "$jar" >&2
        exit 1
    fi
done
export SCALA39_ROOT="$scala_root"
export JAVA_HOME="$java_home"
export SCALA39_JDK_RELEASE="$jdk_release"
export SCALA39_CLASSPATH="$(IFS=:; printf '%s' "${scala_jars[*]}")"

output_path="${1:-$repo_root/docs/typer-classpath-corpus-audit-3.9.0.md}"
tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

for run in first second; do
    (
        cd "$repo_root"
        cargo test -p dotty-typer --test local_definition_audit --locked \
            pinned_scala39_local_definition_audit -- --ignored --nocapture
    ) >"$tmp_dir/$run.log" 2>&1
    sed -n '/^AUDIT_REPORT_BEGIN$/,/^AUDIT_REPORT_END$/p' "$tmp_dir/$run.log" \
        | sed '1d;$d' >"$tmp_dir/$run.report"
    if [[ ! -s "$tmp_dir/$run.report" ]]; then
        cat "$tmp_dir/$run.log" >&2
        printf 'audit report markers were missing\n' >&2
        exit 1
    fi
done

if ! cmp -s "$tmp_dir/first.report" "$tmp_dir/second.report"; then
    diff -u "$tmp_dir/first.report" "$tmp_dir/second.report" >&2 || true
    printf 'normalized audit output was not deterministic\n' >&2
    exit 1
fi

mkdir -p "$(dirname -- "$output_path")"
{
    printf '# Typer classpath corpus audit: Scala 3.9.0\n\n'
    printf 'The report is generated from two byte-identical runs of the pinned Scala 3.9.0 audit. It records first blockers for local method typing, isolated Match-case probes, PatDef attempts, and structural inventories. A moved first blocker is not semantic success. The source corpus, parser/namer setup, Scala revision, JDK 21, and classpath remain pinned.\n\n'
    printf 'Run `tools/typer-classpath-corpus-audit/run` with the environment documented in `docs/typer-v0.1-compatibility.md` to regenerate this report.\n\n'
    printf '## Historical #767–#771 expression sprint snapshot\n\n'
    printf 'At the #772 snapshot, first blockers for term prefix operators and term annotations had moved to zero. These historical measurements are retained here for context; current values and ranking come from the report below.\n\n'
    printf '| First blocker | Before #767 | At #772 snapshot |\n| --- | ---: | ---: |\n'
    printf '| `UnsupportedExpression::PrefixOp` | 66 / 23 files | 0 / 0 |\n'
    printf '| `UnsupportedExpression::Annotated` (term expressions) | 64 / 14 files | 0 / 0 |\n\n'
    printf '## #826–#829 source function support\n\n'
    printf 'The pinned audit after #829 was generated twice and the normalized reports matched byte-for-byte. Relative to the #825 baseline, `UnsupportedExpression::Function` moved from 13 occurrences in 2 files to zero, and `UnsupportedTypeTree::Function` moved from 12 occurrences in 8 files to zero. The new explicit boundary `UnsupportedFunctionLiteralParameter` is now the first blocker for 9 occurrences in 1 file (`compiler/src/dotty/tools/dotc/typer/Synthesizer.scala`); these use inferred lambda parameters and remain unsupported. `UnsupportedTypeTree::FunctionWithMods` is unchanged at 13 occurrences in 2 files. These are first-blocker movements, not evidence of full semantic typing: zero local methods fully typed, and the corpus environment still materializes zero external member symbols.\n\n'
    printf '## #802–#806 local extension hardening\n\n'
    printf 'The initial local-extension blocker was 25 occurrences in 5 files. The current audit splits extension-specific failures from ordinary local method signatures. It attempted 3,297 local method definitions and fully typed zero; moved failures are not counted as semantic success. Focused tests cover a fully typed local extension call, nominal-member precedence, local shadowing, unsupported receiver/signature forms, rollback, and bounded ambiguity.\n\n'
    printf '| Focused extension failure bucket | Count / files | Representative paths |\n| --- | ---: | --- |\n'
    awk '
        /^local_defdef_failures:$/ { in_failures = 1; next }
        /^top_semantic_gaps:$/ { in_failures = 0 }
        in_failures && /^  LocalExtension/ {
            line = $0
            sub(/^  /, "", line)
            name_end = index(line, " [")
            name = substr(line, 1, name_end - 1)
            values = substr(line, index(line, ": ") + 2)
            count = values
            sub(/ \(.*/, "", count)
            files = values
            sub(/^[^(]*\(/, "", files)
            sub(/ files\).*/, "", files)
            examples = values
            sub(/^[^]]*\) \[/, "", examples)
            sub(/^\[/, "", examples)
            sub(/\]$/, "", examples)
            printf "| `%s` | %s / %s | %s |\n", name, count, files, examples
            found++
        }
        END {
            if (!found) printf "| (none observed) | 0 / 0 | — |\n"
        }
    ' "$tmp_dir/first.report"
    printf '\nReceiver or ordinary-argument mismatches remain non-applicable candidates and preserve `MemberNotFound`; the audit does not relabel those as successful typing. Multiple viable same-name local extensions produce `OverloadedSelectionDeferred` in a focused regression. Primitive definitions have no modeled member scopes. If nominal lookup cannot inspect a primitive member index, local extension resolution is not attempted and the original `MemberLookup` error is retained; fallback is available only after a completed index confirms that the ordinary name has no member. External member materialization remains zero.\n\n'
    printf '### Current top ten Typer-owned semantic blockers\n\n'
    printf 'The ranked list below excludes parser/namer and classpath-resolution failures, and excludes the downstream `NoSuccessfulEnclosingMethodTyping` counter. Counts and representative paths are in `top_semantic_gaps` in the raw report.\n\n'
    printf '| Rank | First blocker | Count / files |\n| ---: | --- | ---: |\n'
    awk '
        /^top_semantic_gaps:$/ { in_gaps = 1; next }
        /^top_gap_implementation_scope_notes:$/ { in_gaps = 0 }
        in_gaps && /^  [0-9]+\./ {
            line = $0
            sub(/^  [0-9]+\. /, "", line)
            separator = index(line, ": count=")
            name = substr(line, 1, separator - 1)
            values = substr(line, separator + 8)
            split(values, fields, ", ")
            count = fields[1]
            files = fields[2]
            sub(/^count=/, "", count)
            sub(/^files=/, "", files)
            printf "| %d | `%s` | %s / %s |\n", ++rank, name, count, files
        }
    ' "$tmp_dir/first.report"
    printf '\n'
    printf '### Next-sprint candidates\n\n'
    printf '| Candidate | Smallest useful slice and owner | Prerequisites / reuse | Non-goals |\n| --- | --- | --- | --- |\n'
    printf '| `MissingDeclaredType` (34 / 15) | Start with immutable inferred class fields (14 occurrences / 7 files), then measure mutable and module-class buckets separately. | Reuse declaration source contexts, expression typing, widening, and completion rollback; add a focused fixture before inference. | Do not infer arbitrary types or combine local values, methods, and all class completion. |\n'
    printf '| `AnonymousClassInstantiationDeferred` (32 / 15) | Support one anonymous `new` with one concrete parent in `typer/expression/new.rs`. | Reuse ordinary `New` typing and parent projection; define stable anonymous symbol ownership and class info. | Closure capture, refinement synthesis, and general anonymous-class members. |\n'
    printf '| `UnsupportedSingletonReference` (22 / 1) | Profile the single-file producer, then support one stable singleton reference shape in `typer/expression/references.rs` or `type_projection.rs`. | Reuse `TermRef`, `ThisType`, and stable-prefix checks. | Arbitrary paths, unstable prefixes, and path-dependent relation redesign. |\n'
    printf '| `LocalBlockDeclarationDeferred::val/var definition` (21 / 8) | Split remaining cases by PatDef root/binder shape in `typer/expression/blocks.rs`. | Reuse transactional PatDef lowering, local binders, and assignment support. | General destructuring and reopening supported PatDef forms. |\n'
    printf '| `LocalMethodSignatureDeferred` (14 / 3) | Split exact `feature` values and add one fixture for the most frequent unsupported signature in `typer/completion/local_methods.rs`. | Reuse the shared signature builder and existing parameter/type-parameter scopes. | General dependent results, erased/by-name expansion, or new method inference. |\n\n'
    printf '## #825 MissingDeclaredType producer profile\n\n'
    printf 'The 34 existing first blockers across 15 files are all attributed to source `ValDef` declarations with a right-hand side and a zero-width synthetic inferred `TypeTree`. They split into 24 immutable values and 10 mutable variables; all have semantic `Field` identity. Source `val` versus `var` comes from the AST modifier and is cross-checked against the semantic `MUTABLE` flag; `SymbolKind::Field` alone does not preserve that distinction. The owner kind is `Class` for 24 occurrences and `ModuleClass` for 10. Four immutable module-class values carry `Inline`. The report retains each occurrence with the failed local method tree, type-tree and declaration tree indexes and kinds, source span, modifiers, semantic and context owner kinds, and typer entry path. The profile counts downstream local-method first blockers, so one source declaration can appear more than once.\n\n'
    printf '| Source declaration bucket | Occurrences / files | Representative paths |\n| --- | ---: | --- |\n'
    awk '
        /^missing_declared_type_profile:$/ { in_profile = 1; next }
        /^missing_declared_type_records:$/ { in_profile = 0 }
        in_profile && /^  first_blockers=/ {
            line = $0
            sub(/^  first_blockers=/, "", line)
            split(line, fields, " distinct_declarations=")
            printf "| Total (%s distinct declarations) | %s / 15 | — |\n", fields[2], fields[1]
        }
        in_profile && /^  [^ ]/ && $0 !~ /^  first_blockers=/ {
            line = $0
            sub(/^  /, "", line)
            separator = index(line, ": ")
            name = substr(line, 1, separator - 1)
            values = substr(line, separator + 2)
            count = values
            sub(/ \(.*/, "", count)
            files = values
            sub(/^[^(]*\(/, "", files)
            sub(/ files\).*/, "", files)
            examples = values
            sub(/^[^]]*\) \[/, "", examples)
            sub(/^\[/, "", examples)
            sub(/\]$/, "", examples)
            printf "| `%s` | %s / %s | %s |\n", name, count, files, examples
        }
    ' "$tmp_dir/first.report"
    printf '\n### Family assessment\n\n'
    printf '| Producer family | Smallest useful slice | Infrastructure and reuse | Main risks and non-goals |\n| --- | --- | --- | --- |\n'
    printf '| Immutable `Class` fields (14 / 7) | Infer an RHS for a source `val` member of a class. The 14/7 count is the bucket ceiling; actual reduction depends on which RHS shapes the slice accepts. | Build a field initializer `ExpressionContext` from the namer declaration context and semantic class owner. Reuse expression typing, widening, member lookup, and `run_atomic`. | `expression_context_for` rejects non-method owners. Preserve `this` ownership; guard self and mutual field cycles. Start without `var`, module fields, or arbitrary RHS forms. |\n'
    printf '| Mutable `Class` fields (10 / 6) | Add `var` only after immutable field inference works. | Reuse the class initializer context and RHS inference; preserve the source `Var` modifier and semantic `MUTABLE` flag. | Assignment checks must use the inferred field type; check reads and writes during initialization. No changes to assignment typing in the first slice. |\n'
    printf '| Ordinary `ModuleClass` fields (6 / 2) | Infer one non-inline module member value after class fields. | Reuse field type inference with a module-class owner and the namer-provided lexical context. | Singleton initialization and module cycles differ from per-instance class initialization. Keep module values out of the first slice. |\n'
    printf '| Inline `ModuleClass` fields (4 / 1) | Add inline values as a separate follow-up after ordinary module values. | Reuse only the proven module initializer path and existing inline flags. | Compile-time constant and inline expansion rules add constraints. Do not assume ordinary runtime RHS typing is sufficient. |\n\n'
    printf '\n`complete_symbol` reuses an already-complete symbol, and source type projection reuses a cached type-index entry before projection. On a field cache miss, `complete_symbol_inner` calls `type_of_tpt_inner_journaled`; the inferred `TypeTree` produces the blocker before the RHS is typed. Ordinary and local method signatures use a separate result path: inferred results are guarded against recursion, typed from the RHS, and widened, but neither method path produced a corpus blocker here. `run_atomic` restores symbol information, store allocations, type-index state, and other typer state after failure; local method completion also removes newly entered parameter symbols. Namer-provided declaration and lexical contexts identify the field semantic owner. The observed 34/15 therefore measure field type projection, not method-result inference.\n\n'
    printf '### Recommended next sprint\n\n'
    printf 'Target the immutable inferred `Class` field bucket (14 of 34 occurrences across 7 of 15 files); 14/7 is the bucket ceiling, not a promised first-blocker reduction, because the RHS forms differ. Sequence the sprint narrowly:\n\n1. Add a field-initializer context builder using `declaration_context_of(field)`, its lexical context, and the owning `Class`; do not call `expression_context_for`, which accepts only methods and constructors, and do not push a method scope.\n2. Add a transaction-aware in-progress field set. Detect direct and mutual re-entry before recursive completion; the current `initializing_local_symbols` guard is populated for local values and does not protect class fields. Test rollback after a cycle.\n3. Type an immutable class field RHS through `type_value_expression_inner`, widen with the existing helper, and publish `SymbolInfo::Complete` only on success. Cover a supported RHS, a cycle, an unsupported RHS, and an explicit declared type.\n4. Re-run the pinned audit and report the actual reduction. Only then extend the same path to mutable class fields, and assess module and inline fields as separate increments.\n\nThe first increment belongs in `typer/context.rs`, `typer/transaction.rs`, `typer/completion/mod.rs`, `typer/expression/references.rs`, and focused typer tests. Exclude `var` (10/6), ordinary module values (6/2), inline module values (4/1), method-result inference, local `PatDef`, generalized expected-type inference, and classpath loading from that increment.\n\n'
    printf '## Previous type projection snapshot\n\n'
    printf 'The #738 type-projection measurements remain historical: 28 unsupported type-tree first blockers in 12 files. They are not current counts; current `type_tree_forms` and `unsupported_type_tree_failures` below are the refreshed values.\n\n'
    printf '```text\n'
    cat "$tmp_dir/first.report"
    printf '```\n'
} >"$output_path"

printf 'Wrote deterministic audit report to %s\n' "$output_path"
