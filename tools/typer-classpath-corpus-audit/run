#!/usr/bin/env bash
set -euo pipefail

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(CDPATH= cd -- "$script_dir/../.." && pwd)"
scala_root="${SCALA39_ROOT:?set SCALA39_ROOT to the pinned Scala 3.9.0 checkout}"
java_home="${JAVA_HOME:?set JAVA_HOME to the JDK used for this audit}"
jdk_release="${SCALA39_JDK_RELEASE:?set SCALA39_JDK_RELEASE to the JDK feature version}"
coursier_maven_root="${COURSIER_MAVEN_ROOT:-${HOME}/.cache/coursier/v1/https/repo1.maven.org/maven2}"

if [[ ! -d "$java_home/jmods" || ! -f "$java_home/release" ]]; then
    printf 'JAVA_HOME must contain a release file and a jmods directory: %s\n' "$java_home" >&2
    exit 1
fi
jdk_version="$(sed -n 's/^JAVA_VERSION="\([^"]*\)".*/\1/p' "$java_home/release")"
jdk_feature="${jdk_version%%.*}"
if [[ "$jdk_feature" != "$jdk_release" ]]; then
    printf 'JAVA_HOME is Java %s; SCALA39_JDK_RELEASE is %s\n' "$jdk_feature" "$jdk_release" >&2
    exit 1
fi

revision="777528f19a58e794c9954a42f433373472ec57f8"
actual_revision="$(git -C "$scala_root" rev-parse HEAD)"
if [[ "$actual_revision" != "$revision" ]]; then
    printf 'SCALA39_ROOT revision is %s; expected %s\n' "$actual_revision" "$revision" >&2
    exit 1
fi

scala_jars=(
    "$coursier_maven_root/org/scala-lang/scala3-library_3/3.9.0/scala3-library_3-3.9.0.jar"
    "$coursier_maven_root/org/scala-lang/scala-library/3.9.0/scala-library-3.9.0.jar"
    "$coursier_maven_root/org/scala-lang/scala3-compiler_3/3.9.0/scala3-compiler_3-3.9.0.jar"
    "$coursier_maven_root/org/scala-lang/tasty-core_3/3.9.0/tasty-core_3-3.9.0.jar"
    "$coursier_maven_root/org/scala-lang/scala3-interfaces/3.9.0/scala3-interfaces-3.9.0.jar"
    "$coursier_maven_root/org/scala-lang/modules/scala-asm/9.9.0-scala-1/scala-asm-9.9.0-scala-1.jar"
    "$coursier_maven_root/org/scala-sbt/compiler-interface/1.12.0/compiler-interface-1.12.0.jar"
    "$coursier_maven_root/org/scala-sbt/util-interface/1.11.5/util-interface-1.11.5.jar"
)
for jar in "${scala_jars[@]}"; do
    if [[ ! -f "$jar" ]]; then
        printf 'missing Scala runtime artifact: %s\n' "$jar" >&2
        exit 1
    fi
done
export SCALA39_ROOT="$scala_root"
export JAVA_HOME="$java_home"
export SCALA39_JDK_RELEASE="$jdk_release"
export SCALA39_CLASSPATH="$(IFS=:; printf '%s' "${scala_jars[*]}")"

output_path="${1:-$repo_root/docs/typer-classpath-corpus-audit-3.9.0.md}"
tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

for run in first second; do
    (
        cd "$repo_root"
        cargo test -p dotty-typer --test local_definition_audit --locked \
            pinned_scala39_local_definition_audit -- --ignored --nocapture
    ) >"$tmp_dir/$run.log" 2>&1
    sed -n '/^AUDIT_REPORT_BEGIN$/,/^AUDIT_REPORT_END$/p' "$tmp_dir/$run.log" \
        | sed '1d;$d' >"$tmp_dir/$run.report"
    if [[ ! -s "$tmp_dir/$run.report" ]]; then
        cat "$tmp_dir/$run.log" >&2
        printf 'audit report markers were missing\n' >&2
        exit 1
    fi
done

if ! cmp -s "$tmp_dir/first.report" "$tmp_dir/second.report"; then
    diff -u "$tmp_dir/first.report" "$tmp_dir/second.report" >&2 || true
    printf 'normalized audit output was not deterministic\n' >&2
    exit 1
fi

mkdir -p "$(dirname -- "$output_path")"
{
    printf '# Typer classpath corpus audit: Scala 3.9.0\n\n'
    printf 'The report is generated from two byte-identical runs of the pinned Scala 3.9.0 audit. It records first blockers for local method typing, isolated Match-case probes, PatDef attempts, and structural inventories. A moved first blocker is not semantic success. The source corpus, parser/namer setup, Scala revision, JDK 21, and classpath remain pinned.\n\n'
    printf 'Run `tools/typer-classpath-corpus-audit/run` with the environment documented in `docs/typer-v0.1-compatibility.md` to regenerate this report.\n\n'
    printf '## #767–#771 expression sprint\n\n'
    printf '| First blocker | Before #767 | Current |\n| --- | ---: | ---: |\n'
    printf '| `UnsupportedExpression::PrefixOp` | 66 / 23 files | 0 / 0 |\n'
    printf '| `UnsupportedExpression::Annotated` (term expressions) | 64 / 14 files | 0 / 0 |\n'
    printf '| `MissingDeclaredType` | 34 / 15 files | 34 / 15 |\n'
    printf '| Local extension methods | 25 / 5 files | 25 / 5 |\n'
    printf '| Anonymous class instantiation | 22 / 14 files | 32 / 15 |\n'
    printf '| `UnsupportedSingletonReference` | 22 / 1 file | 22 / 1 |\n'
    printf '| Local val/var definitions | 21 / 8 files | 21 / 8 |\n'
    printf '| `LocalMethodSignatureDeferred` | 14 / 3 files | 14 / 3 |\n'
    printf '| `RecursiveInferredMethodResult` | 13 / 1 file | 13 / 1 |\n'
    printf '| `UnsupportedExpression::Function` | 13 / 2 files | 13 / 2 |\n\n'
    printf 'The two zero generic buckets are first-blocker counts, not successful-expression counts. The corpus audit attempted 3,297 local method definitions and fully typed zero; moved failures are not counted as semantic success. The focused audit fixtures separately prove supported unary and term-annotation lowering and retain deeper `MemberNotFound` and `SourceAnnotationArgumentNotConstant` failures.\n\n'
    printf '| Audit signal | Result | Interpretation |\n| --- | ---: | --- |\n'
    printf '| Term `Annotated` AST nodes | 401 | Syntax reachable in method bodies; not an isolated typing-success count. |\n'
    printf '| Prefix operators `!`, `+`, `-`, `~` | 4,327; 1; 104; 97 | Source syntax counts. The first-blocker audit cannot attribute successful lowering by operator. |\n'
    printf '| Annotation class, argument, and underlying-adaptation first-error buckets | 0 | No such error was the method\047s first blocker; this does not prove each annotation expression succeeded. `TypeNameNotFound` remains 80 / 31 files without annotation-specific attribution. |\n'
    printf '| `@unchecked`-like term annotation uses | Not classified | The audit does not associate term annotation nodes with resolved annotation class symbols. The focused typer test pins the `scala.unchecked` identity. |\n'
    printf '| Annotated type-tree failures | 3 / 2 files | Separate from term-expression annotations; see `UnsupportedTypeTree::Annotated`. |\n\n'
    printf 'External member materialization remains zero, and no local method fully types in this environment. Therefore the corpus does not provide a sound count of successful annotated terms or operator-specific successful prefix lowering. The raw report retains `MemberNotFound` (1 / 1 file), `MemberLookup` (60 / 27 files), and `OverloadedTypeApplicationDeferred` (1 / 1 file) as method first blockers, but does not attribute them to a particular prefix expression. `prefix_operator_forms` and `expression_forms::Annotated` record syntax reachability only.\n\n'
    printf '### Current top ten semantic blockers\n\n'
    printf 'The ranked list below excludes parser/namer and classpath-resolution failures, and excludes the downstream `NoSuccessfulEnclosingMethodTyping` counter. Counts and representative paths are in `top_semantic_gaps` in the raw report.\n\n'
    printf '| Rank | First blocker | Count / files |\n| ---: | --- | ---: |\n'
    printf '| 1 | `MissingDeclaredType` | 34 / 15 |\n| 2 | `AnonymousClassInstantiationDeferred` | 32 / 15 |\n| 3 | `LocalBlockDeclarationDeferred::extension methods` | 25 / 5 |\n| 4 | `UnsupportedSingletonReference` | 22 / 1 |\n| 5 | `LocalBlockDeclarationDeferred::val/var definition` | 21 / 8 |\n| 6 | `LocalMethodSignatureDeferred` | 14 / 3 |\n| 7 | `RecursiveInferredMethodResult` | 13 / 1 |\n| 8 | `UnsupportedExpression::Function` | 13 / 2 |\n| 9 | `UnsupportedTypeTree::FunctionWithMods` | 13 / 2 |\n| 10 | `UnsupportedTypeTree::Function` | 12 / 8 |\n\n'
    printf '### Next-sprint candidates\n\n'
    printf '| Candidate | Smallest useful slice and owner | Prerequisites / reuse | Non-goals |\n| --- | --- | --- | --- |\n'
    printf '| `MissingDeclaredType` (34 / 15) | Split the broad bucket by declaration owner and missing source type tree; start in `typer/type_projection.rs` or `completion/methods.rs` according to the resulting subprofile. | Existing source type-tree projection and declaration contexts; first add exact fixtures for each producer. | Do not infer arbitrary declaration types or combine local val, method, and class completion. |\n'
    printf '| Anonymous class instantiation (32 / 15) | Support one anonymous `new` whose template has one concrete parent, in `typer/expression/new.rs`. | Reuse class-instance typing and parent type projection; will need stable anonymous symbol ownership and class info. | Closure capture, refinement synthesis, and general anonymous-class members. |\n'
    printf '| Local extension methods (25 / 5) | Enter and call one local extension with a single explicit receiver and monomorphic method, in `typer/expression/blocks.rs` plus application lookup. | Reuse `extension_prefix_clauses`, existing local-method scopes, and selected-member application. | General extension search, overload inference, contextual receivers, and multiple receiver clauses. |\n'
    printf '| Local val/var definitions (21 / 8) | Further split `LocalBlockDeclarationDeferred::val/var definition` by PatDef shape before selecting a binder subset, in `typer/expression/blocks.rs`. | Reuse the transactional PatDef lowering and local binder machinery. | Reopening already supported PatDef forms or broad pattern semantics. |\n'
    printf '| Function expressions (13 / 2) | Lower one explicitly typed, single-parameter function expression in the expression typer. | Reuse `Type::Method`, local parameter scopes, and existing closure AST nodes. | Lambda inference, polymorphism, captures, and contextual functions. |\n'
    printf '| Function type trees (12 / 8) | Project one ordinary explicit `Function` type tree in `typer/type_projection.rs`. | Resolve canonical `FunctionN` class identity through definitions/classpath and reuse `Type::Applied`. | Lambda expressions, inference, relation changes, and arbitrary function modifiers. |\n'
    printf '| `FunctionWithMods` type trees (13 / 2) | Classify modifiers and project one ordinary context-function type tree in `typer/type_projection.rs`. | Resolve canonical `ContextFunctionN` identity and distinguish contextual, erased, and capture-related modifiers. | Capture checking, erased-function semantics, and treating modifiers as ordinary annotations. |\n\n'
    printf 'Recommend a focused local extension slice: its 25 blockers form a coherent local declaration family and the typer already records extension receiver clauses and supports ordinary selected applications. Keep the broader `MissingDeclaredType` bucket in measurement until its producers are separated. The classpath gate remains independent: external class and non-class member materializations are both zero, so this corpus cannot yet demonstrate standard-library reachability.\n\n'
    printf '## Previous type projection snapshot\n\n'
    printf 'The #738 type-projection measurements remain historical: 28 unsupported type-tree first blockers in 12 files. They are not current counts; current `type_tree_forms` and `unsupported_type_tree_failures` below are the refreshed values.\n\n'
    printf '```text\n'
    cat "$tmp_dir/first.report"
    printf '```\n'
} >"$output_path"

printf 'Wrote deterministic audit report to %s\n' "$output_path"
