#!/usr/bin/env bash
set -euo pipefail

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(CDPATH= cd -- "$script_dir/../.." && pwd)"

usage() {
    cat <<'USAGE'
Usage: tools/typer-classpath-corpus-audit/run [--verify-determinism] [OUTPUT_PATH]
       tools/typer-classpath-corpus-audit/run --import-prefix-profile [--verify-determinism] [OUTPUT_PATH]
       tools/typer-classpath-corpus-audit/run --import-prefix-profile --source-file RELATIVE_PATH
       tools/typer-classpath-corpus-audit/run --focused-manifest MANIFEST [--verify-determinism] [OUTPUT_PATH]
       tools/typer-classpath-corpus-audit/run --focused-cohort package-term|object-module [--verify-determinism] [OUTPUT_PATH]
       tools/typer-classpath-corpus-audit/run --focused-manifest MANIFEST --compare-legacy-profile [OUTPUT_PATH]

By default, run the pinned audit once and write its report. Pass
--verify-determinism to run it twice and compare normalized output. Set
DOTTY_AUDIT_TMP_ROOT to retain per-run logs and intermediate reports there.
--source-file runs the import-prefix probe only for frozen observations in one
Scala source file and prints its resolver trace without generating a cohort report.
--focused-manifest validates a Scala-root-relative file list, then runs only
those source files and writes a separate FOCUSED / PARTIAL report.
--focused-cohort selects stable path/tree identities from a pinned historical
cohort and writes a separate FOCUSED / PARTIAL report.
--compare-legacy-profile runs the legacy file-only profile once on the same
selected files and records wall time, method/resolver counts, and peak RSS.
USAGE
}

verify_determinism=0
import_prefix_profile=0
output_path=""
source_file=""
focused_manifest=""
focused_cohort=""
compare_legacy_profile=0
while (($#)); do
    case "$1" in
        --verify-determinism)
            verify_determinism=1
            ;;
        --import-prefix-profile)
            import_prefix_profile=1
            ;;
        --focused-manifest)
            if (($# < 2)) || [[ -z "$2" ]]; then
                usage >&2
                exit 2
            fi
            focused_manifest="$2"
            shift
            ;;
        --focused-cohort)
            if (($# < 2)) || [[ -z "$2" ]]; then
                usage >&2
                exit 2
            fi
            focused_cohort="$2"
            shift
            ;;
        --compare-legacy-profile)
            compare_legacy_profile=1
            ;;
        --source-file)
            if (($# < 2)) || [[ -z "$2" ]]; then
                usage >&2
                exit 2
            fi
            source_file="$2"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            usage >&2
            exit 2
            ;;
        *)
            if [[ -n "$output_path" ]]; then
                usage >&2
                exit 2
            fi
            output_path="$1"
            ;;
    esac
    shift
done

if [[ -n "$source_file" && "$import_prefix_profile" != 1 ]]; then
    printf '%s\n' '--source-file requires --import-prefix-profile' >&2
    exit 2
fi
if [[ -n "$source_file" && "$verify_determinism" == 1 ]]; then
    printf '%s\n' '--source-file is a one-run diagnostic and cannot be combined with --verify-determinism' >&2
    exit 2
fi
if [[ -n "$focused_manifest" && -n "$focused_cohort" ]]; then
    printf '%s\n' '--focused-manifest and --focused-cohort are mutually exclusive' >&2
    exit 2
fi
if [[ ( -n "$focused_manifest" || -n "$focused_cohort" ) && "$import_prefix_profile" == 1 ]]; then
    printf '%s\n' 'focused audit selection cannot be combined with --import-prefix-profile' >&2
    exit 2
fi
if [[ "$compare_legacy_profile" == 1 && -z "$focused_manifest$focused_cohort" ]]; then
    printf '%s\n' '--compare-legacy-profile requires a focused manifest or cohort' >&2
    exit 2
fi

scala_root="${SCALA39_ROOT:?set SCALA39_ROOT to the pinned Scala 3.9.0 checkout}"
java_home="${JAVA_HOME:?set JAVA_HOME to the JDK used for this audit}"
jdk_release="${SCALA39_JDK_RELEASE:?set SCALA39_JDK_RELEASE to the JDK feature version}"
coursier_maven_root="${COURSIER_MAVEN_ROOT:-${HOME}/.cache/coursier/v1/https/repo1.maven.org/maven2}"
export COURSIER_MAVEN_ROOT="$coursier_maven_root"

if [[ ! -d "$java_home/jmods" || ! -f "$java_home/release" ]]; then
    printf 'JAVA_HOME must contain a release file and a jmods directory: %s\n' "$java_home" >&2
    exit 1
fi
jdk_version="$(sed -n 's/^JAVA_VERSION="\([^"]*\)".*/\1/p' "$java_home/release")"
jdk_feature="${jdk_version%%.*}"
if [[ "$jdk_feature" != "$jdk_release" ]]; then
    printf 'JAVA_HOME is Java %s; SCALA39_JDK_RELEASE is %s\n' "$jdk_feature" "$jdk_release" >&2
    exit 1
fi

revision="777528f19a58e794c9954a42f433373472ec57f8"
actual_revision="$(git -C "$scala_root" rev-parse HEAD)"
if [[ "$actual_revision" != "$revision" ]]; then
    printf 'SCALA39_ROOT revision is %s; expected %s\n' "$actual_revision" "$revision" >&2
    exit 1
fi

scala_jars=(
    "$coursier_maven_root/org/scala-lang/scala3-library_3/3.9.0/scala3-library_3-3.9.0.jar"
    "$coursier_maven_root/org/scala-lang/scala-library/3.9.0/scala-library-3.9.0.jar"
    "$coursier_maven_root/org/scala-lang/scala3-compiler_3/3.9.0/scala3-compiler_3-3.9.0.jar"
    "$coursier_maven_root/org/scala-lang/tasty-core_3/3.9.0/tasty-core_3-3.9.0.jar"
    "$coursier_maven_root/org/scala-lang/scala3-interfaces/3.9.0/scala3-interfaces-3.9.0.jar"
    "$coursier_maven_root/org/scala-lang/modules/scala-asm/9.9.0-scala-1/scala-asm-9.9.0-scala-1.jar"
    "$coursier_maven_root/org/scala-sbt/compiler-interface/1.12.0/compiler-interface-1.12.0.jar"
    "$coursier_maven_root/org/scala-sbt/util-interface/1.11.5/util-interface-1.11.5.jar"
)
for jar in "${scala_jars[@]}"; do
    if [[ ! -f "$jar" ]]; then
        printf 'missing Scala runtime artifact: %s\n' "$jar" >&2
        exit 1
    fi
done
export SCALA39_ROOT="$scala_root"
export JAVA_HOME="$java_home"
export SCALA39_JDK_RELEASE="$jdk_release"
export SCALA39_CLASSPATH="$(IFS=:; printf '%s' "${scala_jars[*]}")"
if [[ -n "$source_file" ]]; then
    export SCALA39_IMPORT_PREFIX_SOURCE_FILE="$source_file"
    export SCALA39_IMPORT_PREFIX_TRACE_IDS=1
fi

if [[ -z "$output_path" ]]; then
    if [[ -n "$focused_manifest" || -n "$focused_cohort" ]]; then
        output_path="$repo_root/docs/typer-focused-audit-current-3.9.0.md"
    elif [[ "$import_prefix_profile" == 1 ]]; then
        output_path="$repo_root/docs/typer-classpath-import-prefix-profile-current-3.9.0.md"
    else
        output_path="$repo_root/docs/typer-classpath-corpus-audit-3.9.0.md"
    fi
fi
if [[ "$output_path" != /* ]]; then
    output_path="$repo_root/$output_path"
fi
if [[ -n "${DOTTY_AUDIT_TMP_ROOT:-}" ]]; then
    mkdir -p "$DOTTY_AUDIT_TMP_ROOT"
    tmp_dir="$(mktemp -d "$DOTTY_AUDIT_TMP_ROOT/run.XXXXXXXX")"
    trap 'printf "audit intermediates retained at %s\n" "$tmp_dir" >&2' EXIT
else
    tmp_dir="$(mktemp -d)"
    trap 'rm -rf "$tmp_dir"' EXIT
fi

run_names=(first)
if [[ "$verify_determinism" == 1 ]]; then
    run_names+=(second)
fi
if [[ -n "$focused_manifest" || -n "$focused_cohort" ]]; then
    export CARGO_BUILD_JOBS=1
    export RUST_TEST_THREADS=1
    manifest_argument="$focused_manifest"
    if [[ -n "$focused_manifest" && "$focused_manifest" != /* ]]; then
        focused_manifest="$repo_root/$focused_manifest"
    fi
    if [[ -n "$focused_manifest" && ! -f "$focused_manifest" ]]; then
        printf 'focused manifest does not exist: %s\n' "$focused_manifest" >&2
        exit 2
    fi
    if command -v realpath >/dev/null 2>&1; then
        output_path="$(realpath -m -- "$output_path")"
    fi
    case "$output_path" in
        "$repo_root"/docs/typer-classpath-corpus-audit-3.9.0*|\
        "$repo_root"/docs/typer-classpath-import-prefix-profile-3.9.0*)
            printf 'focused output must not overwrite the full audit report or its cohort sidecars\n' >&2
            exit 2
            ;;
    esac
    if [[ -n "$focused_manifest" ]]; then
        if [[ "$focused_manifest" == "$repo_root"/* ]]; then
            selection_label="manifest: ${focused_manifest#"$repo_root"/}"
        elif [[ "$manifest_argument" != /* ]]; then
            selection_label="manifest: $manifest_argument"
        else
            selection_label="external manifest"
        fi
        PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/focused_selection.py" \
            "$focused_manifest" --root "$scala_root" >"$tmp_dir/focused-files.txt"
    else
        case "$focused_cohort" in
            package-term)
                frozen_cohort="$repo_root/docs/typer-classpath-corpus-audit-3.9.0-package-term-first-blockers.tsv"
                ;;
            object-module)
                frozen_cohort="$repo_root/docs/typer-classpath-corpus-audit-1051-object-module-blockers.tsv"
                ;;
            *)
                printf 'unknown focused cohort: %s\n' "$focused_cohort" >&2
                exit 2
                ;;
        esac
        selection_label="frozen cohort: $focused_cohort"
        PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/focused_selection.py" \
            --cohort "$focused_cohort" --root "$scala_root" --repo-root "$repo_root" \
            --methods-output "$tmp_dir/focused-methods.txt" >"$tmp_dir/focused-files.txt"
        export DOTTY_AUDIT_FOCUSED_METHODS="$tmp_dir/focused-methods.txt"
    fi
    export DOTTY_AUDIT_FOCUSED_FILES="$tmp_dir/focused-files.txt"
    if ! (
        cd "$repo_root"
        cargo test -p dotty-typer --test local_definition_audit --locked --no-run
    ) >"$tmp_dir/build.log" 2>&1; then
        cat "$tmp_dir/build.log" >&2
        exit 1
    fi
    for run in "${run_names[@]}"; do
        if ! (
            cd "$repo_root"
            if [[ -x /usr/bin/time ]]; then
                /usr/bin/time -f 'MAX_RSS_KB=%M' -o "$tmp_dir/$run.rss" \
                    cargo test -p dotty-typer --test local_definition_audit --locked \
                    pinned_scala39_local_definition_audit -- --ignored --nocapture
            else
                cargo test -p dotty-typer --test local_definition_audit --locked \
                    pinned_scala39_local_definition_audit -- --ignored --nocapture
            fi
        ) >"$tmp_dir/$run.log" 2>&1; then
            cat "$tmp_dir/$run.log" >&2
            exit 1
        fi
        sed -n '/^FOCUSED_REPORT_BEGIN$/,/^FOCUSED_REPORT_END$/p' "$tmp_dir/$run.log" \
            | sed '1d;$d' >"$tmp_dir/$run.focused-report"
        if [[ ! -s "$tmp_dir/$run.focused-report" ]]; then
            cat "$tmp_dir/$run.log" >&2
            printf 'focused report markers were missing\n' >&2
            exit 1
        fi
        if [[ -n "$focused_cohort" ]]; then
            PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/reconcile_focused_cohort.py" \
                "$focused_cohort" "$frozen_cohort" "$tmp_dir/$run.focused-report" \
                --rows "$tmp_dir/$run.focused-cohort.tsv" >"$tmp_dir/$run.cohort-summary.txt"
        fi
    done
    if [[ "$verify_determinism" == 1 ]] && ! cmp -s "$tmp_dir/first.focused-report" "$tmp_dir/second.focused-report"; then
        diff -u "$tmp_dir/first.focused-report" "$tmp_dir/second.focused-report" >&2 || true
        printf 'normalized focused report was not deterministic\n' >&2
        exit 1
    fi
    if [[ -n "$focused_cohort" && "$verify_determinism" == 1 ]] \
        && ! cmp -s "$tmp_dir/first.focused-cohort.tsv" "$tmp_dir/second.focused-cohort.tsv"; then
        diff -u "$tmp_dir/first.focused-cohort.tsv" "$tmp_dir/second.focused-cohort.tsv" >&2 || true
        printf 'focused cohort reconciliation was not deterministic\n' >&2
        exit 1
    fi
    if [[ "$compare_legacy_profile" == 1 ]]; then
        rss_value() {
            local value=""
            if [[ -f "$1" ]]; then
                value="$(sed -n 's/^MAX_RSS_KB=//p' "$1" | tail -1)"
            fi
            if [[ -n "$value" ]]; then
                printf '%s' "$value"
            else
                printf unavailable
            fi
        }
        profile_files="$(paste -sd, "$tmp_dir/focused-files.txt")"
        if ! (
            cd "$repo_root"
            unset DOTTY_AUDIT_FOCUSED_FILES DOTTY_AUDIT_FOCUSED_METHODS
            export DOTTY_AUDIT_PROFILE_FILES="$profile_files"
            if [[ -x /usr/bin/time ]]; then
                /usr/bin/time -f 'MAX_RSS_KB=%M' -o "$tmp_dir/legacy.rss" \
                    cargo test -p dotty-typer --test local_definition_audit --locked \
                    pinned_scala39_local_definition_audit -- --ignored --nocapture
            else
                cargo test -p dotty-typer --test local_definition_audit --locked \
                    pinned_scala39_local_definition_audit -- --ignored --nocapture
            fi
        ) >"$tmp_dir/legacy.log" 2>&1; then
            cat "$tmp_dir/legacy.log" >&2
            exit 1
        fi
        legacy_timing="$(sed -n 's/^AUDIT_PROFILE_SUMMARY //p' "$tmp_dir/legacy.log" | tail -1)"
        if [[ -z "$legacy_timing" ]]; then
            cat "$tmp_dir/legacy.log" >&2
            printf 'performance comparison timing markers were missing\n' >&2
            exit 1
        fi
        printf 'mode\twall_ms\tmethods_attempted\tmethods_typed\tpackage_requests\tmember_requests\tpeak_rss_kb\n' >"$tmp_dir/comparison.tsv"
        for run in "${run_names[@]}"; do
            focused_timing="$(sed -n 's/^FOCUSED_TIMING //p' "$tmp_dir/$run.log" | tail -1)"
            if [[ -z "$focused_timing" ]]; then
                cat "$tmp_dir/$run.log" >&2
                printf 'focused performance timing marker was missing for %s\n' "$run" >&2
                exit 1
            fi
            printf 'focused-%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                "$run" \
                "$(sed -n 's/.*wall_ms=\([0-9]*\).*/\1/p' <<<"$focused_timing")" \
                "$(sed -n 's/^methods_attempted=//p' "$tmp_dir/first.focused-report")" \
                "$(sed -n 's/^methods_typed=//p' "$tmp_dir/first.focused-report")" \
                "$(sed -n 's/^  package_requests=//p' "$tmp_dir/first.focused-report")" \
                "$(sed -n 's/^  member_requests=//p' "$tmp_dir/first.focused-report")" \
                "$(rss_value "$tmp_dir/$run.rss")" \
                >>"$tmp_dir/comparison.tsv"
        done
        printf 'legacy-file-profile\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$(sed -n 's/.*wall_ms=\([0-9]*\).*/\1/p' <<<"$legacy_timing")" \
            "$(sed -n 's/.*methods_attempted=\([0-9]*\).*/\1/p' <<<"$legacy_timing")" \
            "$(sed -n 's/.*methods_typed=\([0-9]*\).*/\1/p' <<<"$legacy_timing")" \
            "$(sed -n 's/.*resolver_package_requests=\([0-9]*\).*/\1/p' <<<"$legacy_timing")" \
            "$(sed -n 's/.*resolver_member_requests=\([0-9]*\).*/\1/p' <<<"$legacy_timing")" \
            "$(rss_value "$tmp_dir/legacy.rss")" \
            >>"$tmp_dir/comparison.tsv"
    fi
    mkdir -p "$(dirname -- "$output_path")"
    {
        printf '# Focused Scala 3.9.0 typer audit\n\n'
        printf 'Status: **FOCUSED / PARTIAL**. This report covers only the selected source files and methods; full-corpus totals and frozen full-audit assertions do not apply.\n\n'
        printf 'Inputs are pinned to Scala revision `%s`, Scala artifacts 3.9.0, and JDK %s.\n\n' "$revision" "$jdk_version"
        printf 'Selection: `%s`\n\n' "$selection_label"
        if [[ -n "$focused_cohort" ]]; then
            printf '## Frozen row reconciliation\n\n'
            printf 'The selected `path#tree` methods were joined back to every frozen cohort row. Rows missing a current method outcome remain explicit in the sidecar. Summary: `%s`.\n\n' "$(cat "$tmp_dir/first.cohort-summary.txt")"
            printf 'Row-level comparison: [`%s`](%s).\n\n' \
                "$(basename -- "${output_path%.md}-cohort.tsv")" \
                "$(basename -- "${output_path%.md}-cohort.tsv")"
        fi
        if [[ "$compare_legacy_profile" == 1 ]]; then
            comparison_path="${output_path%.md}-performance.tsv"
            printf '## Same-file performance comparison\n\n'
            printf 'The legacy file-only profile and focused mode used the same selected paths and pinned inputs. This diagnostic is intentionally separate from normalized output because wall time and peak RSS vary by run.\n\n'
            printf 'Measured rows: [`%s`](%s).\n\n' "$(basename -- "$comparison_path")" "$(basename -- "$comparison_path")"
        fi
        printf '## Selected audit output\n\n```text\n'
        cat "$tmp_dir/first.focused-report"
        printf '```\n\n'
        if [[ "$verify_determinism" == 1 ]]; then
            printf 'Two normalized focused reports matched byte-for-byte.\n'
        else
            printf 'One run completed; determinism was not checked.\n'
        fi
    } >"$output_path"
    if [[ -n "$focused_cohort" ]]; then
        cp "$tmp_dir/first.focused-cohort.tsv" "${output_path%.md}-cohort.tsv"
    fi
    if [[ "$compare_legacy_profile" == 1 ]]; then
        cp "$tmp_dir/comparison.tsv" "${output_path%.md}-performance.tsv"
    fi
    printf 'Wrote focused audit report to %s\n' "$output_path"
    exit 0
fi
if [[ "$import_prefix_profile" == 1 ]]; then
    export SCALA39_IMPORT_PREFIX_BASELINE_PROFILE="$repo_root/docs/typer-classpath-import-prefix-profile-3.9.0.md"
    for run in "${run_names[@]}"; do
        if ! (
            cd "$repo_root"
            cargo test -p dotty-typer --test local_definition_audit --locked \
                pinned_scala39_import_prefix_typing_probe -- --ignored --nocapture
        ) >"$tmp_dir/$run.log" 2>&1; then
            cat "$tmp_dir/$run.log" >&2
            exit 1
        fi
        if [[ -n "$source_file" ]]; then
            cat "$tmp_dir/$run.log"
            exit 0
        fi
        sed -n '/^AUDIT_IMPORT_PREFIX_BEGIN$/,/^AUDIT_IMPORT_PREFIX_END$/p' "$tmp_dir/$run.log" \
            | sed '1d;$d' >"$tmp_dir/$run.profile"
        sed -n '/^AUDIT_IMPORT_PREFIX_RECONCILIATION_BEGIN$/,/^AUDIT_IMPORT_PREFIX_RECONCILIATION_END$/p' "$tmp_dir/$run.log" \
            | sed '1d;$d' >"$tmp_dir/$run.reconciliation"
        if [[ ! -s "$tmp_dir/$run.profile" ]]; then
            cat "$tmp_dir/$run.log" >&2
            printf 'import-prefix audit markers were missing\n' >&2
            exit 1
        fi
        if [[ ! -s "$tmp_dir/$run.reconciliation" ]]; then
            cat "$tmp_dir/$run.log" >&2
            printf 'import-prefix reconciliation markers were missing\n' >&2
            exit 1
        fi
        PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/import_prefix_profile.py" \
            "$tmp_dir/$run.profile" \
            --rows "$tmp_dir/$run.import-prefix-targets.tsv" \
            --evidence "$tmp_dir/$run.import-prefix-evidence.tsv" \
            --candidate-baseline "$repo_root/docs/typer-classpath-import-prefix-profile-3.9.0.md" \
            --candidate-baseline-evidence "$repo_root/docs/typer-classpath-import-prefix-profile-3.9.0-import-prefix-classpath-evidence.tsv" \
            --candidates "$tmp_dir/$run.lexical-package-candidates.tsv" \
            --classpath "$SCALA39_CLASSPATH" \
            --jdk-jmods "$java_home/jmods" \
            --jdk-release "$jdk_release" >"$tmp_dir/$run.import-prefix-summary.txt"
        PYTHONPATH="$script_dir" PYTHONDONTWRITEBYTECODE=1 \
            python3 "$script_dir/reconcile_import_prefix_rows.py" \
            --baseline "$repo_root/docs/typer-classpath-import-prefix-profile-3.9.0.md" \
            --baseline-evidence "$repo_root/docs/typer-classpath-import-prefix-profile-3.9.0-import-prefix-classpath-evidence.tsv" \
            --current-profile "$tmp_dir/$run.profile" \
            --current-evidence "$tmp_dir/$run.import-prefix-evidence.tsv" \
            --current-reconciliation "$tmp_dir/$run.reconciliation" \
            --rows "$tmp_dir/$run.reconciliation-enriched.tsv" \
            --qualified-cohort "$tmp_dir/$run.qualified-cohort.tsv" \
            --summary "$tmp_dir/$run.qualified-cohort-summary.txt" \
            2>/dev/null
        printf '%s ' "$run"
        sed -n '/^IMPORT_PREFIX_TIMING /p' "$tmp_dir/$run.log"
    done
    if [[ "$verify_determinism" == 1 ]]; then
        if ! cmp -s "$tmp_dir/first.profile" "$tmp_dir/second.profile"; then
            diff -u "$tmp_dir/first.profile" "$tmp_dir/second.profile" >&2 || true
            printf 'normalized import-prefix audit output was not deterministic\n' >&2
            exit 1
        fi
        if ! cmp -s "$tmp_dir/first.reconciliation" "$tmp_dir/second.reconciliation"; then
            diff -u "$tmp_dir/first.reconciliation" "$tmp_dir/second.reconciliation" >&2 || true
            printf 'normalized import-prefix reconciliation was not deterministic\n' >&2
            exit 1
        fi
        for sidecar in \
            import-prefix-targets.tsv \
            import-prefix-evidence.tsv \
            lexical-package-candidates.tsv \
            import-prefix-summary.txt \
            reconciliation-enriched.tsv \
            qualified-cohort.tsv \
            qualified-cohort-summary.txt; do
            if ! cmp -s "$tmp_dir/first.$sidecar" "$tmp_dir/second.$sidecar"; then
                diff -u "$tmp_dir/first.$sidecar" "$tmp_dir/second.$sidecar" >&2 || true
                printf 'normalized import-prefix %s sidecar was not deterministic\n' "$sidecar" >&2
                exit 1
            fi
        done
        import_prefix_run_summary='Both normalized profiles, reconciliation, and generated sidecars matched byte-for-byte.'
    else
        import_prefix_run_summary='One profile run completed; determinism was not checked.'
    fi
    PYTHONDONTWRITEBYTECODE=1 python3 "$script_dir/scala39_import_oracle.py" \
        >"$tmp_dir/import-oracle.txt"
    prefix_targets_path="${output_path%.md}-import-prefix-targets.tsv"
    prefix_evidence_path="${output_path%.md}-import-prefix-classpath-evidence.tsv"
    prefix_candidates_path="${output_path%.md}-lexical-package-candidates.tsv"
    prefix_reconciliation_path="${output_path%.md}-reconciliation.tsv"
    prefix_qualified_cohort_path="${output_path%.md}-qualified-cohort.tsv"
    prefix_qualified_summary_path="${output_path%.md}-qualified-cohort-summary.txt"
    profile_field() {
        awk -F= -v wanted="$1" '$1 == wanted { print $2; exit }' "$tmp_dir/first.profile"
    }
    baseline_observations="$(profile_field baseline_observations)"
    baseline_files="$(profile_field baseline_files)"
    baseline_targets="$(profile_field baseline_targets)"
    baseline_origins="$(profile_field baseline_blocker_origins)"
    current_import_failures="$(profile_field current_import_qualifier_not_found)"
    current_unresolved="$(profile_field current_unresolved_next_segment)"
    current_term_gaps="$(profile_field current_term_object_gaps)"
    current_unmatched="$(profile_field current_unmatched_request_traces)"
    reconciliation_rows="$(profile_field reconciliation_rows)"
    reconciliation_unresolved="$(profile_field reconciliation_unresolved_rows)"
    reconciliation_advanced="$(profile_field reconciliation_advanced_rows)"
    new_current_observations="$(profile_field new_current_observations_outside_baseline)"
    reconciliation_with_evidence="$(profile_field reconciliation_rows_with_resolver_evidence)"
    reconciliation_with_package_identity="$(awk -F '\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "current_selected_package_identity") col = i; next } $col != "" && $col != "-" { count++ } END { print count + 0 }' "$tmp_dir/first.reconciliation-enriched.tsv")"
    reconciliation_final_resolved="$(awk -F '\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "final_import_identity") col = i; next } { n = split($col, outcomes, ";"); for (j = 1; j <= n; j++) if (outcomes[j] ~ /=resolved::/) count++ } END { print count + 0 }' "$tmp_dir/first.reconciliation")"
    reconciliation_final_absent="$(awk -F '\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "final_import_identity") col = i; next } { n = split($col, outcomes, ";"); for (j = 1; j <= n; j++) if (outcomes[j] ~ /=absent::/) count++ } END { print count + 0 }' "$tmp_dir/first.reconciliation")"
    reconciliation_method_typed="$(awk -F '\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "current_method_typed") col = i; next } $col == "true" { count++ } END { print count + 0 }' "$tmp_dir/first.reconciliation")"
    unresolved_movement="$((baseline_observations - current_unresolved))"
    reconciliation_line_count="$(wc -l <"$tmp_dir/first.reconciliation" | tr -d '[:space:]')"
    if [[ "$reconciliation_line_count" -ne $((baseline_observations + 1)) ]]; then
        printf 'expected one reconciliation header and %s frozen rows, got %s lines\n' \
            "$baseline_observations" "$reconciliation_line_count" >&2
        exit 1
    fi
    mkdir -p "$(dirname -- "$output_path")"
    {
        printf '# #1180 lexical package import-prefix checkpoint\n\n'
        printf 'The frozen [#1128 import-prefix profile](typer-classpath-import-prefix-profile-3.9.0.md) remains unchanged. This post-#1168–#1175 checkpoint starts from its exact weighted source rows and blocker origins, then collects current resolver outcomes; it does not treat a moved first blocker as full-method success.\n\n'
        printf '%s Inputs are pinned to Scala revision `%s`, Scala artifacts 3.9.0, and JDK %s. The full-audit typed-local-method denominator remains 3,297.\n\n' "$import_prefix_run_summary" "$revision" "$jdk_version"
        printf '## Frozen cohort reconciliation\n\n'
        printf '| Measure | Frozen #1128 | Current |\n| --- | ---: | ---: |\n'
        printf '| Weighted first-segment observations | %s | %s unresolved next-segment observations |\n' "$baseline_observations" "$current_unresolved"
        printf '| Files | %s | %s |\n' "$baseline_files" "$(sed -n 's/^observations=[0-9]* files=\([0-9]*\).*/\1/p' "$tmp_dir/first.import-prefix-summary.txt" | head -1)"
        printf '| Target keys | %s | %s |\n' "$baseline_targets" "$(sed -n 's/^observations=[0-9]* files=[0-9]* target_keys=\([0-9]*\).*/\1/p' "$tmp_dir/first.import-prefix-summary.txt" | head -1)"
        printf '| Distinct blocker origins | %s | %s |\n\n' "$baseline_origins" "$(sed -n 's/^observations=[0-9]* files=[0-9]* target_keys=[0-9]* unique_blocker_origins=\([0-9]*\).*/\1/p' "$tmp_dir/first.import-prefix-summary.txt" | head -1)"
        printf 'The exact frozen-row reconciliation contains `%s` rows: `%s` still fail with `ImportQualifierNotFound` at the same import tree, and `%s` have advanced to a later current method blocker. Resolver traces matched the frozen qualifier in `%s` rows; `%s` rows also record a selected package identity. These are separate from final selector outcomes: `%s` selectors have an observed final selected symbol and `%s` have no exact singular selected symbol recorded (wildcards are not reduced to one symbol). The full-method typed boolean is true for `%s` frozen rows. The separate unresolved-only view contains `%s` rows, including `%s` newly observed imports outside the frozen cohort. Across the selected roots there are `%s` unresolved-prefix observations, `%s` term/object materialization gaps, and `%s` without a matching failed resolver trace. The #1132 full-corpus local-method baseline remains 0 / 3,297; this import-prefix profile does not refresh that full-corpus count.\n\n' "$reconciliation_rows" "$reconciliation_unresolved" "$reconciliation_advanced" "$reconciliation_with_evidence" "$reconciliation_with_package_identity" "$reconciliation_final_resolved" "$reconciliation_final_absent" "$reconciliation_method_typed" "$current_unresolved" "$new_current_observations" "$current_import_failures" "$current_term_gaps" "$current_unmatched"
        printf '## Historical qualified-candidate cohort\n\n'
        printf 'The frozen #1128 source-qualified cohort is joined independently from the remaining rows. It retains all 1,615 historically evidenced observations, with current package identity and member selection reported only when the audit observed them. A missing current identity is not treated as successful lexical resolution.\n\n'
        cat "$tmp_dir/first.qualified-cohort-summary.txt"
        printf '\nSee [`%s`](%s) for all 1,615 joined candidate rows, [`%s`](%s) for the full 2,394-row enriched reconciliation, and [`%s`](%s) for the standalone before/after target summary. The original source-package probe, ordered historical candidate evidence, current same-import probe, other failed import trees observed in the same method, final selector outcome, and full-method status remain separate columns.\n\n' \
            "$(basename -- "$prefix_qualified_cohort_path")" "$(basename -- "$prefix_qualified_cohort_path")" \
            "$(basename -- "$prefix_reconciliation_path")" "$(basename -- "$prefix_reconciliation_path")" \
            "$(basename -- "$prefix_qualified_summary_path")" "$(basename -- "$prefix_qualified_summary_path")"
        printf '## Current evidence and next slice\n\n'
        printf 'The current unresolved-prefix view has `%s` source-package registry hits across its 31 target keys. Separately, all 1,615 rows in the frozen historical qualified cohort now have a resolver request matched to the source-context candidate chain and a selected package identity recorded. For example, `Resident.scala` resolves `core` as `dotty.tools.dotc.core` and selects the canonical TASTy object `dotty.tools.dotc.core.Contexts`; the enclosing method still stops later at `TypeNameNotFound`, and a wildcard has no singular final member. Package resolution, final selector resolution, and full-method typing remain distinct outcomes.\n\n' "$(sed -n 's/^observations=[0-9]* files=[0-9]* target_keys=[0-9]* unique_blocker_origins=[0-9]* direct=[0-9]* inherited=[0-9]* unknown_origins=[0-9]* root_qualified=[0-9]* source_relative_candidates=[0-9]* source_package_registry_hits=\([0-9]*\).*/\1/p' "$tmp_dir/first.import-prefix-summary.txt" | head -1)"
        printf 'Exactly one next sprint is recommended: B, verify source package declarations against classpath resources for the 31 unresolved target keys (1,063 weighted observations, 81 files, 393 blocker origins; zero source-package registry hits). This is larger than the previously measured unresolved-supertype cohort (212 errors / 51 files) and anonymous-class cohort (32 / 15 files), while avoiding guessed lexical parents. The full-corpus blocker and deferred-loading profiles have not been refreshed in this checkpoint, so their historical values are not presented as current.\n\n'
        printf '## Current selection and evidence summary\n\n```text\n'
        cat "$tmp_dir/first.import-prefix-summary.txt" "$tmp_dir/import-oracle.txt"
        printf '```\n\n'
        printf 'Scala 3.9 oracle fixtures confirm that a package-relative path in the current package wins over a root path, root lookup succeeds when that relative path is absent, stacked package clauses expose their enclosing package scope to an import qualifier, and a single dotted package clause does not synthesize that parent scope. Intermediate packages can exist only through descendants, and a missing selected member remains an error after package resolution. An object/package same-name collision is rejected. The measured cohort has no root-qualified imports, no direct-resource resolver rejection, and no non-package first-segment or ambiguous resolver outcome; `_root_` behavior is covered by the separate oracle fixture. These findings do not promise that all imports or typer failures will be fixed.\n\n'
        printf 'See [`%s`](%s) for the row-level reconciliation of every frozen observation, including its original method and attempted method, direct/inherited attribution, failed qualifier and segment, #1128 evidence category, current source selector, package-prefix result, final selected symbol or explicit absence, current blocker, and full-method typed boolean. The target and classpath TSVs below are separate unresolved-only views. See [`%s`](%s) for unresolved target keys, weighted observations, files, blocker origins, source lookups, and classifications. See [`%s`](%s) for direct and descendant resources, archive origin, directory-only evidence, and effective Multi-Release JAR versions. See [`%s`](%s) for representative lexical package candidates, source registry status, and pinned classpath evidence; frozen #1128 and current #1180 rows are labeled separately. Raw stable unresolved observation rows are included below.\n\n' \
            "$(basename -- "$prefix_reconciliation_path")" "$(basename -- "$prefix_reconciliation_path")" \
            "$(basename -- "$prefix_targets_path")" "$(basename -- "$prefix_targets_path")" \
            "$(basename -- "$prefix_evidence_path")" "$(basename -- "$prefix_evidence_path")" \
            "$(basename -- "$prefix_candidates_path")" "$(basename -- "$prefix_candidates_path")"
        printf '```text\n'
        cat "$tmp_dir/first.profile"
        printf '```\n'
    } >"$output_path"
    cp "$tmp_dir/first.import-prefix-targets.tsv" "$prefix_targets_path"
    cp "$tmp_dir/first.import-prefix-evidence.tsv" "$prefix_evidence_path"
    cp "$tmp_dir/first.lexical-package-candidates.tsv" "$prefix_candidates_path"
