companion_requests="$(report_field package_term_companion_object_resource_requests)"
companion_targets="$(report_field package_term_distinct_targets_with_companion_object_resource)"
top_loads="$(report_field top_level_class_loads)"
median_depth="$(report_field median_dependency_depth)"
p95_depth="$(report_field p95_dependency_depth)"
max_depth="$(report_field max_dependency_depth)"
