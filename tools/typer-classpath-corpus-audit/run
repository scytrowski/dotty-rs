#!/usr/bin/env bash
set -euo pipefail

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(CDPATH= cd -- "$script_dir/../.." && pwd)"
scala_root="${SCALA39_ROOT:?set SCALA39_ROOT to the pinned Scala 3.9.0 checkout}"
java_home="${JAVA_HOME:?set JAVA_HOME to the JDK used for this audit}"
jdk_release="${SCALA39_JDK_RELEASE:?set SCALA39_JDK_RELEASE to the JDK feature version}"
coursier_maven_root="${COURSIER_MAVEN_ROOT:-${HOME}/.cache/coursier/v1/https/repo1.maven.org/maven2}"

if [[ ! -d "$java_home/jmods" || ! -f "$java_home/release" ]]; then
    printf 'JAVA_HOME must contain a release file and a jmods directory: %s\n' "$java_home" >&2
    exit 1
fi
jdk_version="$(sed -n 's/^JAVA_VERSION="\([^"]*\)".*/\1/p' "$java_home/release")"
jdk_feature="${jdk_version%%.*}"
if [[ "$jdk_feature" != "$jdk_release" ]]; then
    printf 'JAVA_HOME is Java %s; SCALA39_JDK_RELEASE is %s\n' "$jdk_feature" "$jdk_release" >&2
    exit 1
fi

revision="777528f19a58e794c9954a42f433373472ec57f8"
actual_revision="$(git -C "$scala_root" rev-parse HEAD)"
if [[ "$actual_revision" != "$revision" ]]; then
    printf 'SCALA39_ROOT revision is %s; expected %s\n' "$actual_revision" "$revision" >&2
    exit 1
fi

scala_jars=(
    "$coursier_maven_root/org/scala-lang/scala3-library_3/3.9.0/scala3-library_3-3.9.0.jar"
    "$coursier_maven_root/org/scala-lang/scala-library/3.9.0/scala-library-3.9.0.jar"
    "$coursier_maven_root/org/scala-lang/scala3-compiler_3/3.9.0/scala3-compiler_3-3.9.0.jar"
    "$coursier_maven_root/org/scala-lang/tasty-core_3/3.9.0/tasty-core_3-3.9.0.jar"
    "$coursier_maven_root/org/scala-lang/scala3-interfaces/3.9.0/scala3-interfaces-3.9.0.jar"
    "$coursier_maven_root/org/scala-lang/modules/scala-asm/9.9.0-scala-1/scala-asm-9.9.0-scala-1.jar"
    "$coursier_maven_root/org/scala-sbt/compiler-interface/1.12.0/compiler-interface-1.12.0.jar"
    "$coursier_maven_root/org/scala-sbt/util-interface/1.11.5/util-interface-1.11.5.jar"
)
for jar in "${scala_jars[@]}"; do
    if [[ ! -f "$jar" ]]; then
        printf 'missing Scala runtime artifact: %s\n' "$jar" >&2
        exit 1
    fi
done
export SCALA39_ROOT="$scala_root"
export JAVA_HOME="$java_home"
export SCALA39_JDK_RELEASE="$jdk_release"
export SCALA39_CLASSPATH="$(IFS=:; printf '%s' "${scala_jars[*]}")"

output_path="${1:-$repo_root/docs/typer-classpath-corpus-audit-3.9.0.md}"
tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

for run in first second; do
    (
        cd "$repo_root"
        cargo test -p dotty-typer --test local_definition_audit --locked \
            pinned_scala39_local_definition_audit -- --ignored --nocapture
    ) >"$tmp_dir/$run.log" 2>&1
    sed -n '/^AUDIT_REPORT_BEGIN$/,/^AUDIT_REPORT_END$/p' "$tmp_dir/$run.log" \
        | sed '1d;$d' >"$tmp_dir/$run.report"
    if [[ ! -s "$tmp_dir/$run.report" ]]; then
        cat "$tmp_dir/$run.log" >&2
        printf 'audit report markers were missing\n' >&2
        exit 1
    fi
done

if ! cmp -s "$tmp_dir/first.report" "$tmp_dir/second.report"; then
    diff -u "$tmp_dir/first.report" "$tmp_dir/second.report" >&2 || true
    printf 'normalized audit output was not deterministic\n' >&2
    exit 1
fi

mkdir -p "$(dirname -- "$output_path")"
{
    printf '# Typer classpath corpus audit: Scala 3.9.0\n\n'
    printf 'The report is generated from two byte-identical runs of the pinned Scala 3.9.0 audit. It records first blockers for local method typing, isolated Match-case probes, PatDef attempts, and structural inventories. A moved first blocker is not semantic success. The source corpus, parser/namer setup, Scala revision, JDK feature release %s, and classpath remain pinned.\n\n' "$jdk_release"
    printf 'Run `tools/typer-classpath-corpus-audit/run` with the environment documented in `docs/typer-v0.1-compatibility.md` to regenerate this report.\n\n'
    printf '## Historical #767–#771 expression sprint snapshot\n\n'
    printf 'At the #772 snapshot, first blockers for term prefix operators and term annotations had moved to zero. These historical measurements are retained here for context; current values and ranking come from the report below.\n\n'
    printf '| First blocker | Before #767 | At #772 snapshot |\n| --- | ---: | ---: |\n'
    printf '| `UnsupportedExpression::PrefixOp` | 66 / 23 files | 0 / 0 |\n'
    printf '| `UnsupportedExpression::Annotated` (term expressions) | 64 / 14 files | 0 / 0 |\n\n'
    printf '## #826–#829 source function support\n\n'
    printf 'The pre-#826 baseline at `89d84f41444a2a03a6a5bd39cf45176ca894a03b` and the post-#829 audit were run against the same pinned Scala 3.9.0 corpus, JDK 21, and classpath. The post-#829 audit ran twice; normalized reports matched byte-for-byte. It tracks the same 25 local methods by source path, line, and name. The 13 expression cases now split into 9 explicit `UnsupportedFunctionLiteralParameter` deferrals and 4 `ImportQualifierNotFound` blockers; none fully typed. The 12 ordinary function-type cases now reach `SymbolResolution` in 8 files; none fully typed. `FunctionWithMods` remains 13 / 2 files. These are first-blocker movements, not semantic success. The corpus still typed zero local methods overall and materialized zero external member symbols.\n\n'
    printf '| Baseline family | New first blocker | Count / files | Representative methods |\n| --- | --- | ---: | --- |\n'
    awk '
        /^source_function_method_outcomes:$/ { in_profile = 1; next }
        /^missing_declared_type_profile:$/ { in_profile = 0 }
        in_profile && /^  (expression::Function|type::Function)::/ {
            line = $0
            sub(/^  /, "", line)
            separator = index(line, ": count=")
            key = substr(line, 1, separator - 1)
            family = key
            if (family ~ /^expression::Function::/) {
                sub(/^expression::Function::/, "", family)
                baseline = "`UnsupportedExpression::Function`"
            } else {
                sub(/^type::Function::/, "", family)
                baseline = "`UnsupportedTypeTree::Function`"
            }
            values = substr(line, separator + 8)
            count = values
            sub(/,.*/, "", count)
            files = values
            sub(/^[^,]*, files=/, "", files)
            sub(/,.*/, "", files)
            examples = values
            sub(/^.*examples=\[/, "", examples)
            sub(/\]$/, "", examples)
            printf "| %s | `%s` | %s / %s | %s |\n", baseline, family, count, files, examples
        }
    ' "$tmp_dir/first.report"
    printf '\n### Same-method comparison\n\n'
    printf '| Method from the pre-#826 first-blocker set | Baseline family | First blocker after #829 |\n| --- | --- | --- |\n'
    awk '
        /^source_function_method_outcomes:$/ { in_profile = 1; next }
        /^missing_declared_type_profile:$/ { in_profile = 0 }
        in_profile && /^  method=/ {
            record = $0
            sub(/^  method=/, "", record)
            location_end = index(record, " baseline_form=")
            location = substr(record, 1, location_end - 1)
            details = substr(record, location_end)
            sub(/^ baseline_form=/, "", details)
            form = details
            sub(/ first_blocker=.*/, "", form)
            blocker = details
            sub(/^.* first_blocker=/, "", blocker)
            if (form == "expression::Function") baseline = "`UnsupportedExpression::Function`"
            else baseline = "`UnsupportedTypeTree::Function`"
            printf "| `%s` | %s | `%s` |\n", location, baseline, blocker
        }
    ' "$tmp_dir/first.report"
    printf '\nThe detailed rows are emitted from the same local-method attempts as the aggregate audit; the generated raw report below preserves all bucket counts and paths. `Typed` would mean the local method received a typed-tree mapping; none of these 25 rows did.\n\n'
    printf '## #802–#806 local extension hardening\n\n'
    printf 'The initial local-extension blocker was 25 occurrences in 5 files. The current audit splits extension-specific failures from ordinary local method signatures. It attempted 3,297 local method definitions and fully typed zero; moved failures are not counted as semantic success. Focused tests cover a fully typed local extension call, nominal-member precedence, local shadowing, unsupported receiver/signature forms, rollback, and bounded ambiguity.\n\n'
    printf '| Focused extension failure bucket | Count / files | Representative paths |\n| --- | ---: | --- |\n'
    awk '
        /^local_defdef_failures:$/ { in_failures = 1; next }
        /^top_semantic_gaps:$/ { in_failures = 0 }
        in_failures && /^  LocalExtension/ {
            line = $0
            sub(/^  /, "", line)
            name_end = index(line, " [")
            name = substr(line, 1, name_end - 1)
            values = substr(line, index(line, ": ") + 2)
            count = values
            sub(/ \(.*/, "", count)
            files = values
            sub(/^[^(]*\(/, "", files)
            sub(/ files\).*/, "", files)
            examples = values
            sub(/^[^]]*\) \[/, "", examples)
            sub(/^\[/, "", examples)
            sub(/\]$/, "", examples)
            printf "| `%s` | %s / %s | %s |\n", name, count, files, examples
            found++
        }
        END {
            if (!found) printf "| (none observed) | 0 / 0 | — |\n"
        }
    ' "$tmp_dir/first.report"
    printf '\nReceiver or ordinary-argument mismatches remain non-applicable candidates and preserve `MemberNotFound`; the audit does not relabel those as successful typing. Multiple viable same-name local extensions produce `OverloadedSelectionDeferred` in a focused regression. Primitive definitions have no modeled member scopes. If nominal lookup cannot inspect a primitive member index, local extension resolution is not attempted and the original `MemberLookup` error is retained; fallback is available only after a completed index confirms that the ordinary name has no member. External member materialization remains zero.\n\n'
    printf '### Current top ten Typer-owned semantic blockers\n\n'
    printf 'The ranked list below excludes parser/namer and classpath-resolution failures, and excludes the downstream `NoSuccessfulEnclosingMethodTyping` counter. Counts and representative paths are in `top_semantic_gaps` in the raw report.\n\n'
    printf '| Rank | First blocker | Count / files |\n| ---: | --- | ---: |\n'
    awk '
        /^top_semantic_gaps:$/ { in_gaps = 1; next }
        /^top_gap_implementation_scope_notes:$/ { in_gaps = 0 }
        in_gaps && /^  [0-9]+\./ {
            line = $0
            sub(/^  [0-9]+\. /, "", line)
            separator = index(line, ": count=")
            name = substr(line, 1, separator - 1)
            values = substr(line, separator + 8)
            split(values, fields, ", ")
            count = fields[1]
            files = fields[2]
            sub(/^count=/, "", count)
            sub(/^files=/, "", files)
            printf "| %d | `%s` | %s / %s |\n", ++rank, name, count, files
        }
    ' "$tmp_dir/first.report"
    printf '\n'
    printf '### #903 hardening and refreshed local-method profile\n\n'
    printf 'The #903 hardening reran the pinned Scala 3.9.0 audit twice with JDK feature release %s; normalized output matched byte-for-byte and is unchanged from the post-#902 profile. The #899 baseline had 14 local signature first-blocker observations across 3 files; the current profile has 0. The 8 by-name observations moved past the signature guard in #900, and the 6 parameter-modifier observations moved past it in #902. #903 adds regression coverage for generic nested by-name methods with same-name scopes, forward by-name calls, and rollback during by-name type projection and local body checking. This blocker movement is not semantic success: the two by-name origins and all six selected inline rows still stop at `ImportQualifierNotFound`; the full audit types 0 of 3,297 local methods, and 0 corpus applications reach `ByNameApplicationParameterDeferred`. `RecursiveInferredMethodResult` does not appear among current full-corpus first blockers; focused self- and mutual-recursion tests keep that behavior explicit.\n\n' "$jdk_release"
    printf 'The table below preserves every #899 baseline row. `Signature completion` is recorded independently from the enclosing method blocker: it is `unknown` because this corpus audit does not probe signature completion in isolation. `Enclosing method typing` is `not typed` for each row; `Current first blocker` is the whole-file local-method attempt result, not evidence that its signature completed.\n\n'
    printf '| Method (pinned source tree) | Original feature | Current first blocker | Signature completion | Enclosing method typing | Baseline classification |\n| --- | --- | --- | --- | --- | --- |\n'
    printf '| `SymUtils.scala#1839 instantiateCFT` | by-name parameters | `ImportQualifierNotFound` | unknown | not typed | direct |\n'
    printf '| `SymUtils.scala#1874 iftParamss` | by-name parameters | `ImportQualifierNotFound` | unknown | not typed | inherited |\n'
    printf '| `Typer.scala#5163 cases` | by-name parameters | `ImportQualifierNotFound` | unknown | not typed | direct |\n'
    printf '| `Typer.scala#5232 ascription` | by-name parameters | `ImportQualifierNotFound` | unknown | not typed | inherited |\n'
    printf '| `Typer.scala#5296 fromRepeated` | by-name parameters | `ImportQualifierNotFound` | unknown | not typed | inherited |\n'
    printf '| `Typer.scala#5380 typedWildcardStarArgExpr` | by-name parameters | `ImportQualifierNotFound` | unknown | not typed | inherited |\n'
    printf '| `Typer.scala#5420 typedTpt` | by-name parameters | `ImportQualifierNotFound` | unknown | not typed | inherited |\n'
    printf '| `Typer.scala#5491 handlePattern` | by-name parameters | `ImportQualifierNotFound` | unknown | not typed | inherited |\n'
    printf '| `MegaPhase.scala#1125 inLocalContext` | parameter modifiers | `ImportQualifierNotFound` | unknown | not typed | direct |\n'
    printf '| `MegaPhase.scala#1440 transformNamed` | parameter modifiers | `ImportQualifierNotFound` | unknown | not typed | inherited |\n'
    printf '| `MegaPhase.scala#1224 mapValDef` | parameter modifiers | `ImportQualifierNotFound` | unknown | not typed | inherited |\n'
    printf '| `MegaPhase.scala#1301 mapDefDef` | parameter modifiers | `ImportQualifierNotFound` | unknown | not typed | inherited |\n'
    printf '| `MegaPhase.scala#2407 transformUnnamed` | parameter modifiers | `ImportQualifierNotFound` | unknown | not typed | inherited |\n'
    printf '| `MegaPhase.scala#2116 mapPackage` | parameter modifiers | `ImportQualifierNotFound` | unknown | not typed | inherited |\n\n'
    printf '### #929 local value blocker profile and recommended next Typer sprint\n\n'
    printf 'The pinned audit attributes all 21 first-blocker observations across 8 files to 14 distinct `ValDef` declarations; none are `PatDef`. Five declarations produce repeated sibling-method observations, accounting for 7 observations beyond the first observation for each declaration; all 21 rows are inherited observations from the enclosing method attempt. The exact method/declaration pairs, source spans, full source modifiers, type form, RHS, visibility, annotations, and attribution are listed in `local_value_blocker_profile` in the raw audit below. Every row reaches the same guard in `type_block_stat_expansion`: a `ValDef` with any modifier other than `Var` returns `LocalBlockDeclarationDeferred::val/var definition` before calling `type_value_expression_inner` and `type_local_value`. Plain `val` and `var` rows are absent from this bucket because they pass that modifier guard. Namer already maps `Given`, `Implicit`, `Lazy`, and `Inline` to `SymbolFlags`; `type_local_value` currently allocates local symbols with only `MUTABLE`, so local modifier-flag preservation is missing plumbing, separate from implicit lookup, lazy initialization, and inline expansion semantics.\n\n'
    printf '| Observed source family | Observations | Distinct declarations | Files | Type tree shape | Key implementation concern |\n| --- | ---: | ---: | ---: | --- | --- |\n'
    printf '| Given `ValDef` (`Given,Final,Lazy`) | 5 | 4 | 3 | 5 explicit; 1 named and 3 anonymous declarations | `GIVEN` flag, local contextual lookup, and given initialization behavior |\n'
    printf '| Named `implicit val` | 12 | 7 | 2 | 10 inferred; 2 explicit | `IMPLICIT` flag and contextual lookup; explicit typing already has a bounded path |\n'
    printf '| `lazy val` | 3 | 2 | 2 | 3 inferred | `LAZY` flag and lazy initialization semantics |\n'
    printf '| `inline val` | 1 | 1 | 1 | 1 inferred | `INLINE` flag and compile-time expansion semantics |\n'
    printf '| PatDef / plain val / plain var | 0 | 0 | 0 | — | No occurrence in this first-blocker bucket |\n\n'
    printf 'Ranked follow-up candidates use distinct declaration counts for implementation reach and report observation counts separately. Prefer a narrowly scoped named explicit-type `implicit val` slice (2 observations from 1 declaration in `JSCodeGen.scala`): it reaches the existing explicit type-projection and local-value machinery while containing the source shape. The issue must also specify correct local implicit visibility; creating a correctly flagged local symbol is available through the existing `SymbolFlags::IMPLICIT`, but implicit lookup needs its own focused contract and tests. If that coupling makes the first slice unsafe, use the measured `lazy val` family (3 observations / 2 declarations / 2 files) as the fallback after its initialization boundary is specified. Lazy vals rank ahead of givens despite lower reach because their implementation does not also require contextual lookup; both still need an explicit initialization contract.\n\n'
    printf '| Rank | Candidate family | Reach | Existing reuse | Missing work and risk | Recommended slice |\n| ---: | --- | --- | --- | --- | --- |\n'
    printf '| 1 | Named `implicit val` | 12 observations / 7 declarations / 2 files | `type_local_value`, explicit type projection, inferred widening, local scope insertion, initializer recursion guard, typed-tree mapping | Typer local symbols currently retain only `MUTABLE`; preserve `IMPLICIT` and define local implicit lookup | Explicitly typed named `implicit val` (2 observations / 1 declaration / 1 file), then inferred named forms |\n'
    printf '| 2 | `lazy val` | 3 / 2 / 2 | Inferred local-value typing, local scope, recursion guard, typed-tree mapping | Preserve `LAZY`; establish lazy initializer and self-reference semantics | Fallback bounded to inferred direct `ValDef` rows |\n'
    printf '| 3 | Given `ValDef` | 5 / 4 / 3 | Explicit type projection and local-value typing | Preserve `GIVEN`; separate named from anonymous given and specify contextual lookup plus initialization | Defer until implicit lookup boundary is established |\n'
    printf '| 4 | `inline val` | 1 / 1 / 1 | Inferred local-value typing | Preserve `INLINE`; compile-time evaluation/expansion is not present | Defer |\n\n'
    printf '### #899–#903 local method signature profile\n\n'
    printf 'The profile counts local methods whose first blocker is a local signature failure. `direct_origins` identifies methods carrying that signature feature; `inherited_methods` are sibling methods attributed to the same enclosing failure. The #899 baseline had 14 affected methods across 3 files; after #900 and #902, none remain at this blocker, confirmed by the #903 rerun. This deterministic supplemental audit was run twice with JDK feature release %s and the pinned Scala 3.9.0 source/artifact inputs; normalized output matched byte-for-byte. Full method typing is reported separately.\n\n' "$jdk_release"
    printf '| Feature payload | Affected methods | Files | Distinct methods | Direct origins | Inherited methods | Blocker origins |\n| --- | ---: | ---: | ---: | ---: | ---: | ---: |\n'
    awk '
        /^  features:$/ { in_features = 1; next }
        /^  records:$/ { in_features = 0 }
        in_features && /^    / {
            line = $0
            sub(/^    /, "", line)
            separator = index(line, ": affected_local_methods=")
            if (!separator) next
            feature = substr(line, 1, separator - 1)
            gsub(/^"|"$/, "", feature)
            values = substr(line, separator + 2)
            split(values, fields, " ")
            for (i = 1; i <= 6; i++) sub(/^[^=]*=/, "", fields[i])
            printf "| `%s` | %s | %s | %s | %s | %s | %s |\n", feature, fields[1], fields[2], fields[3], fields[4], fields[5], fields[6]
            found = 1
        }
        END { if (!found) print "| (none) | 0 | 0 | 0 | 0 | 0 | 0 |" }
    ' "$tmp_dir/first.report"
    printf '\nResidual local signature first-blocker rows appear below with their source path, line/span, tree index, feature payload, signature shape, blocker origin, and direct/inherited attribution. No rows remain at this blocker after #902.\n\n'
    printf '```text\n'
    awk '
        /^  records:$/ { in_records = 1; next }
        /^by_name_method_outcomes:$/ { in_records = 0 }
        in_records && /^    / { sub(/^    /, ""); print; found = 1 }
        END { if (!found) print "(none; 0 occurrences)" }
    ' "$tmp_dir/first.report"
    printf '```\n\n'
    printf '#### #902 selected inline-parameter cohort\n\n'
    printf 'The six rows from the #899 `parameter modifiers` feature profile are tracked by their pinned source-tree indexes below. They are local `inline` methods; a moved blocker is not full method typing.\n\n'
    printf '| Baseline local method tree | Current first blocker |\n| --- | --- |\n'
    awk '
        /^inline_parameter_signature_outcomes_after_902:$/ { in_cohort = 1; next }
        /^by_name_method_outcomes:$/ { in_cohort = 0 }
        in_cohort && /^  / {
            line = $0
            sub(/^  /, "", line)
            split(line, fields, "=")
            printf "| `%s=%s` | `%s` |\n", fields[1], fields[2], fields[3]
        }
    ' "$tmp_dir/first.report"
    printf '\n'
    printf '### #900 by-name downstream blocker inspection\n\n'
    printf 'The two direct by-name origins are measured individually after signature support. In the whole-file audit, both now reach `ImportQualifierNotFound` as their first blocker. No matching `ByNameApplicationParameterDeferred` observation is emitted for these methods; their application sites are still behind the enclosing method blocker. At the #900 snapshot the `ByNameCall.scala` fixture reached the application deferral boundary; the #901 follow-up below removes it for that bounded local-call shape.\n\n'
    printf '| Corpus method | Result shape | First blocker after #900 | Application sites reached by audit |\n| --- | --- | --- | --- |\n'
    awk '
        /^by_name_method_outcomes:$/ { in_profile = 1; next }
        in_profile && /^  / {
            line = $0
            sub(/^  /, "", line)
            separator = index(line, "=")
            method = substr(line, 1, separator - 1)
            blocker = substr(line, separator + 1)
            if (method ~ /SymUtils.scala::instantiateCFT$/) {
                printf "| `SymUtils.scala::instantiateCFT` | Explicit | `%s` | No; recursive RHS and `returnProto` calls remain behind the enclosing blocker. |\n", blocker
            } else if (method ~ /Typer.scala::cases$/) {
                printf "| `Typer.scala::cases` | Inferred | `%s` | No; calls from `typedTyped` remain behind the enclosing blocker. |\n", blocker
            }
        }
        /^singleton_reference_profile:$/ { in_profile = 0 }
    ' "$tmp_dir/first.report"
    printf '\n'
    printf '### #901 by-name application follow-up\n\n'
    printf 'The focused local `ByNameCall.scala` fixture previously produced one `ByNameApplicationParameterDeferred` observation. After #901 it produces zero such failures and its one local method types successfully. In the pinned corpus, zero applications from the two direct by-name origins reached application typing before or after #901: both remain blocked by `ImportQualifierNotFound` in their enclosing methods. Thus the corpus count is 0 moved past the application blocker; the focused regression demonstrates the implemented call behavior.\n\n'
    printf '\n'
    printf '### Historical #825 next-sprint candidates (pre-#856)\n\n'
    printf '| Candidate | Smallest useful slice and owner | Prerequisites / reuse | Non-goals |\n| --- | --- | --- | --- |\n'
    printf '| `MissingDeclaredType` (34 / 15, historical) | #825 proposed immutable inferred class fields (14 occurrences / 7 files); implemented in #854–#856 and audited below. | Reused declaration source contexts, expression typing, widening, and completion rollback. | Current audit distinguishes first-blocker movement from completed semantics. |\n'
    printf '| `AnonymousClassInstantiationDeferred` (32 / 15) | Support one anonymous `new` with one concrete parent in `typer/expression/new.rs`. | Reuse ordinary `New` typing and parent projection; define stable anonymous symbol ownership and class info. | Closure capture, refinement synthesis, and general anonymous-class members. |\n'
    printf '| `UnsupportedSingletonReference` (historical 22 / 1) | #880 profiled the baseline; #881–#883 now project, relate, and preserve supported literal constants. | Reuse `Type::Constant`, literal expression typing, bounded relations, expected adaptation, and stable-prefix validation. | Arbitrary paths, unstable prefixes, and path-dependent relation redesign. |\n'
    printf '| `LocalBlockDeclarationDeferred::val/var definition` (21 / 8, profiled in #929) | All observations are modified direct `ValDef`; #929 recommends explicit-type named `implicit val` first, with inferred `lazy val` as fallback. | Reuse `type_local_value`, local scopes, type projection/inference, recursion protection, and typed mappings. | `GIVEN` / `IMPLICIT` lookup, lazy initialization, and inline expansion remain separate semantics. |\n'
    printf '| `LocalMethodSignatureDeferred` (0 current; after #902) | #900 moved 8 by-name and #902 moved 6 inline-parameter observations past the signature guard. | Reuse `source_method_flags` and the shared method-signature builder; local parameter symbols retain `Inline`. | Inline expansion; dependent results; erased parameter support or new method inference. |\n\n'
    printf '## Historical #825 MissingDeclaredType producer profile (pre-#856)\n\n'
    printf 'Before #856, the 34 first blockers across 15 files were all attributed to source `ValDef` declarations with a right-hand side and a zero-width synthetic inferred `TypeTree`. They split into 24 immutable values and 10 mutable variables; all have semantic `Field` identity. Source `val` versus `var` comes from the AST modifier and is cross-checked against the semantic `MUTABLE` flag; `SymbolKind::Field` alone does not preserve that distinction. The owner kind is `Class` for 24 occurrences and `ModuleClass` for 10. Four immutable module-class values carry `Inline`. Counts are downstream local-method first blockers, so one source declaration can appear more than once. The baseline profile is frozen here; current profile values are listed separately below.\n\n'
    printf '| Source declaration bucket | Occurrences / files | Representative paths |\n| --- | ---: | --- |\n'
    printf '| Total (17 distinct declarations) | 34 / 15 | — |\n'
    printf '| `value::Field::owner=Class::synthetic inferred TypeTree::rhs=true::modifiers=::semantic_mutable=false` | 14 / 7 | compiler/src/dotty/tools/dotc/core/TypeErrors.scala, compiler/src/dotty/tools/dotc/inlines/Inliner.scala, compiler/src/dotty/tools/dotc/printing/ReplPrinter.scala, compiler/src/dotty/tools/dotc/reporting/Profile.scala, compiler/src/dotty/tools/dotc/rewrites/Rewrites.scala, compiler/src/dotty/tools/dotc/transform/Bridges.scala, compiler/src/dotty/tools/io/FileWriters.scala |\n'
