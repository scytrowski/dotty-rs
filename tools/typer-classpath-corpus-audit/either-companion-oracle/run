#!/usr/bin/env bash
set -euo pipefail

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(CDPATH= cd -- "$script_dir/../../.." && pwd)"
scala_root="${SCALA39_ROOT:?set SCALA39_ROOT to the pinned Scala checkout}"
java_home="${JAVA_HOME:?set JAVA_HOME to the pinned JDK}"
jdk_release="${SCALA39_JDK_RELEASE:?set SCALA39_JDK_RELEASE to 21}"
maven_root="${COURSIER_MAVEN_ROOT:-${HOME}/.cache/coursier/v1/https/repo1.maven.org/maven2}"
expected_scala_revision="777528f19a58e794c9954a42f433373472ec57f8"

actual_scala_revision="$(git -C "$scala_root" rev-parse HEAD)"
if [[ "$actual_scala_revision" != "$expected_scala_revision" ]]; then
    printf 'Scala checkout is %s; expected %s\n' "$actual_scala_revision" "$expected_scala_revision" >&2
    exit 1
fi
if [[ ! -f "$java_home/release" || ! -d "$java_home/jmods" ]]; then
    printf 'JAVA_HOME must contain release and jmods: %s\n' "$java_home" >&2
    exit 1
fi
if ! grep -Eq "^JAVA_VERSION=\"${jdk_release}(\.|\")" "$java_home/release"; then
    printf 'JAVA_HOME is not Java %s: %s\n' "$jdk_release" "$java_home" >&2
    exit 1
fi
if [[ "$jdk_release" != 21 ]]; then
    printf 'this oracle is pinned to JDK 21, got %s\n' "$jdk_release" >&2
    exit 1
fi

python3 - "$maven_root" "$script_dir/scala-artifacts.sha256.tsv" <<'PY'
import hashlib
from pathlib import Path
import sys

root, manifest = Path(sys.argv[1]), Path(sys.argv[2])
rows = [line.split("\t", 1) for line in manifest.read_text(encoding="utf-8").splitlines()]
errors = []
for expected, relative in rows:
    artifact = root / relative
    if not artifact.is_file():
        errors.append(f"missing pinned artifact: {relative}")
        continue
    actual = hashlib.sha256(artifact.read_bytes()).hexdigest()
    if actual != expected:
        errors.append(f"checksum mismatch for {relative}: {actual}")
if errors:
    print("\n".join(errors), file=sys.stderr)
    raise SystemExit(1)
print(f"verified {len(rows)} pinned Scala 3.9.0 artifacts")
PY

jar_paths=(
    "$maven_root/org/scala-lang/scala3-library_3/3.9.0/scala3-library_3-3.9.0.jar"
    "$maven_root/org/scala-lang/scala-library/3.9.0/scala-library-3.9.0.jar"
    "$maven_root/org/scala-lang/scala3-compiler_3/3.9.0/scala3-compiler_3-3.9.0.jar"
    "$maven_root/org/scala-lang/tasty-core_3/3.9.0/tasty-core_3-3.9.0.jar"
    "$maven_root/org/scala-lang/scala3-interfaces/3.9.0/scala3-interfaces-3.9.0.jar"
    "$maven_root/org/scala-lang/modules/scala-asm/9.9.0-scala-1/scala-asm-9.9.0-scala-1.jar"
    "$maven_root/org/scala-sbt/compiler-interface/1.12.0/compiler-interface-1.12.0.jar"
    "$maven_root/org/scala-sbt/util-interface/1.11.5/util-interface-1.11.5.jar"
)
classpath="$(IFS=:; printf '%s' "${jar_paths[*]}")"
scratch_root="${DOTTY_EITHER_COMPANION_TMP_ROOT:-$repo_root/target/typer-either-companion-oracle-tmp}"
mkdir -p "$scratch_root"
run_dir="$(mktemp -d "$scratch_root/run.XXXXXXXX")"
mkdir -p "$run_dir/positive-classes"
trap 'printf "oracle evidence retained at %s\n" "$run_dir" >&2' EXIT

compile() {
    local source="$1" output_dir="$2" log="$3"
    mkdir -p "$output_dir"
    "$java_home/bin/java" -cp "$classpath" dotty.tools.dotc.Main \
        -classpath "$classpath" -d "$output_dir" \
        -Vprint:typer -color:never "$source" >"$log" 2>&1
}

compile "$script_dir/Positive.scala" "$run_dir/positive-classes" "$run_dir/positive.log"
for expected in \
    'LeftProjection.apply[A, B](this)' \
    'RightProjection.apply[A, B](this)' \
    'issue1747oracle.Owners.First.Node.apply[Int](1)' \
    'issue1747oracle.Owners.Second.Node.apply[String]("x")' \
    'UserCompanion.Node.apply[Int](1)' \
    'UserCompanion.Node.apply("x", 1)' \
    'def constructor: issue1747oracle.Ordinary.Node[Int] = new Node[Int](1)'; do
    if ! grep -Fq "$expected" "$run_dir/positive.log"; then
        printf 'Scala typer output did not contain expected form: %s\n' "$expected" >&2
        cat "$run_dir/positive.log" >&2
        exit 1
    fi
done
if grep -Fq 'issue1747oracle.Ordinary.Node.apply' "$run_dir/positive.log"; then
    printf '%s\n' 'ordinary nested class unexpectedly used a generated companion apply' >&2
    exit 1
fi

expect_failure() {
    local name="$1" expected="$2" source="$script_dir/$1.scala"
    if compile "$source" "$run_dir/$name-classes" "$run_dir/$name.log"; then
        printf 'Scala compiler unexpectedly accepted %s\n' "$name" >&2
        exit 1
    fi
    if ! grep -Fq "$expected" "$run_dir/$name.log"; then
        printf 'Scala compiler diagnostic for %s did not contain: %s\n' "$name" "$expected" >&2
        cat "$run_dir/$name.log" >&2
        exit 1
    fi
}

expect_failure NegativeWrongArity 'missing argument for parameter value of method apply in object Node'
expect_failure NegativeWrongType 'Required: String'
expect_failure NegativePrivateConstructor 'object Secret in object PrivateOwner does not take parameters'
expect_failure NegativeAmbiguousOverload 'Ambiguous overload.'

printf 'Scala source revision: %s\nJDK: %s\n' "$actual_scala_revision" "$jdk_release"
printf '%s\n' 'Generated nested case-class companions and apply trees match the expected forms.'
printf '%s\n' 'Wrong arity/type, inaccessible constructor, and ambiguous overload controls were rejected.'
