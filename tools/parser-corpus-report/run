#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repo_dir=$(cd "${script_dir}/../.." && pwd)

if [[ $# -lt 1 ]]; then
  echo "usage: $0 <scala3-checkout> [--namer] [--skip-oracle] [--output <report.json>] [--timeout-ms <n>]" >&2
  exit 2
fi

scala3_root=$(cd "$1" && pwd)
shift
scala3_revision=777528f19a58e794c9954a42f433373472ec57f8
cats_revision=32a50dcfad9d897459bb755c4b5a22b4c7bc745c
cats_effect_revision=eb0cc258fc732fc37f22f117c2e81d5554d67024
kyo_tag=v1.0.0-RC4
kyo_revision=e03b76f98796ba8cd94d39fbb7fa2ffd70409987
shapeless_tag=v3.6.0
shapeless_revision=1d89fac9c7a3af2ee4878171ce745ef122ed3291

actual_scala3_revision=$(git -C "$scala3_root" rev-parse HEAD 2>/dev/null || true)
if [[ "$actual_scala3_revision" != "$scala3_revision" ]]; then
  echo "expected Scala 3.9.0 revision $scala3_revision, got ${actual_scala3_revision:-unknown}" >&2
  exit 1
fi

cache_dir=${DOTTY_PARSER_CORPUS_CACHE:-"${repo_dir}/target/parser-corpus-sources"}
mkdir -p "$cache_dir"

ensure_checkout() {
  local name=$1
  local repository=$2
  local tag=$3
  local revision=$4
  local checkout="${cache_dir}/${name}-${tag}"
  if [[ ! -e "$checkout" ]]; then
    git clone --depth 1 --branch "$tag" "$repository" "$checkout"
  fi
  local actual
  actual=$(git -C "$checkout" rev-parse HEAD 2>/dev/null || true)
  if [[ "$actual" != "$revision" ]]; then
    echo "$name checkout revision mismatch: expected $revision, got ${actual:-unknown} at $checkout" >&2
    exit 1
  fi
  printf '%s\n' "$checkout"
}

cats_root=$(ensure_checkout cats https://github.com/typelevel/cats.git v2.13.0 "$cats_revision")
cats_effect_root=$(ensure_checkout cats-effect https://github.com/typelevel/cats-effect.git v3.7.1 "$cats_effect_revision")
kyo_root=$(ensure_checkout kyo https://github.com/getkyo/kyo.git "$kyo_tag" "$kyo_revision")
shapeless_root=$(ensure_checkout shapeless-3 https://github.com/typelevel/shapeless-3.git "$shapeless_tag" "$shapeless_revision")

cd "$repo_dir"
scala3_roots=("${scala3_root}/library/src" "${scala3_root}/compiler/src")
mapfile -t cats_roots < <(cargo run --quiet --locked -p dotty-parser-corpus-report -- --list-production-roots "$cats_root")
mapfile -t cats_effect_roots < <(cargo run --quiet --locked -p dotty-parser-corpus-report -- --list-production-roots "$cats_effect_root")
mapfile -t kyo_discovered_roots < <(cargo run --quiet --locked -p dotty-parser-corpus-report -- --list-production-roots "$kyo_root")
kyo_roots_output=$(PYTHONPATH="$script_dir${PYTHONPATH:+:$PYTHONPATH}" python3 - "$kyo_root" "${kyo_discovered_roots[@]}" <<'PY'
import pathlib
import sys
from source_inventory import kyo_scala3_production_roots

roots = [pathlib.Path(root) for root in sys.argv[2:]]
for root in kyo_scala3_production_roots(pathlib.Path(sys.argv[1]), roots):
    print(root)
PY
)
mapfile -t kyo_roots <<<"$kyo_roots_output"
mapfile -t shapeless_roots < <(cargo run --quiet --locked -p dotty-parser-corpus-report -- --list-production-roots "$shapeless_root")
if [[ ${#cats_roots[@]} -eq 0 || ${#cats_effect_roots[@]} -eq 0 || ${#kyo_roots[@]} -eq 0 || ${#shapeless_roots[@]} -eq 0 ]]; then
  echo "no production source roots found in a pinned corpus checkout" >&2
  exit 1
fi

skip_oracle=0
forwarded_args=()
for arg in "$@"; do
  if [[ "$arg" == "--skip-oracle" ]]; then
    skip_oracle=1
  else
    forwarded_args+=("$arg")
  fi
done

parser_revision=$(git -C "$repo_dir" rev-parse HEAD)
tmp_root=${TMPDIR:-"${repo_dir}/target"}
mkdir -p "$tmp_root"
manifest=$(mktemp "${tmp_root%/}/parser-corpus.XXXXXX.manifest")
scala_output=$(mktemp "${tmp_root%/}/parser-corpus.XXXXXX.scala-output")
source_set_counts=$(mktemp "${tmp_root%/}/parser-corpus.XXXXXX.source-sets")
trap 'rm -f "$manifest" "$scala_output" "$source_set_counts"' EXIT

all_roots=("${scala3_roots[@]}" "${cats_roots[@]}" "${cats_effect_roots[@]}" "${kyo_roots[@]}" "${shapeless_roots[@]}")
for root in "${all_roots[@]}"; do
  if [[ ! -d "$root" ]]; then
    echo "corpus source root does not exist: $root" >&2
    exit 1
  fi
done

PYTHONPATH="$script_dir${PYTHONPATH:+:$PYTHONPATH}" python3 - "${scala3_root}" "${scala3_roots[@]}" -- \
  "${cats_root}" "${cats_roots[@]}" -- \
  "${cats_effect_root}" "${cats_effect_roots[@]}" -- \
  "${kyo_root}" "${kyo_roots[@]}" -- \
  "${shapeless_root}" "${shapeless_roots[@]}" <<'PY'
import pathlib
import subprocess
import sys

from source_inventory import tracked_scala_sources

arguments = sys.argv[1:]
root_groups = []
while "--" in arguments:
    separator = arguments.index("--")
    root_groups.append(arguments[:separator])
    arguments = arguments[separator + 1:]
root_groups.append(arguments)
if len(root_groups) != 5:
    raise SystemExit(f"expected five source-root groups, got {len(root_groups)}")

for group in root_groups:
    repository, roots = group[0], group[1:]
    try:
        tracked_scala_sources(pathlib.Path(repository), [pathlib.Path(root) for root in roots])
    except (OSError, subprocess.CalledProcessError, ValueError) as error:
        raise SystemExit(str(error)) from error
PY

oracle_args=()
if [[ "$skip_oracle" == 0 ]]; then
  PYTHONPATH="$script_dir${PYTHONPATH:+:$PYTHONPATH}" python3 - "$manifest" "$source_set_counts" \
    "$scala3_root" "$cats_root" "$cats_effect_root" "$kyo_root" "$shapeless_root" \
    "${scala3_roots[@]}" -- "${cats_roots[@]}" -- "${cats_effect_roots[@]}" -- "${kyo_roots[@]}" -- "${shapeless_roots[@]}" <<'PY'
import pathlib
import subprocess
import sys
from source_inventory import tracked_scala_sources

manifest_path = pathlib.Path(sys.argv[1])
counts_path = pathlib.Path(sys.argv[2])
roots_by_name = dict(zip(
    ("scala3", "cats", "cats-effect", "kyo", "shapeless-3"),
    map(pathlib.Path, sys.argv[3:8]),
    strict=True,
))
arguments = sys.argv[7:]
root_groups = []
while "--" in arguments:
    separator = arguments.index("--")
    root_groups.append(arguments[:separator])
    arguments = arguments[separator + 1:]
root_groups.append(arguments)
if len(root_groups) != len(roots_by_name):
    raise SystemExit(f"expected {len(roots_by_name)} source-root groups, got {len(root_groups)}")

groups = {}
for (name, root), source_roots in zip(roots_by_name.items(), root_groups, strict=True):
    try:
        groups[name] = tracked_scala_sources(root, [pathlib.Path(path) for path in source_roots])
    except (OSError, subprocess.CalledProcessError, ValueError) as error:
        raise SystemExit(str(error)) from error

owners = {}
for name, paths in groups.items():
    unique = sorted(set(paths), key=lambda path: path.as_posix())
    for path in unique:
        prior_owner = owners.setdefault(path, name)
        if prior_owner != name:
            raise SystemExit(f"source appears in both {prior_owner} and {name}: {path}")
    groups[name] = unique

with manifest_path.open("w", encoding="utf-8", newline="\n") as manifest:
    for name in groups:
        for path in groups[name]:
            text = path.as_posix()
            if "\t" in text or "\n" in text:
                raise SystemExit(f"unsupported tab/newline in source path: {text!r}")
            manifest.write(f"compilation\t{text}\n")

counts_path.write_text("".join(f"{name}\t{len(paths)}\n" for name, paths in groups.items()), encoding="utf-8")
PY
  file_count=$(wc -l <"$manifest" | tr -d '[:space:]')
  tools/scala-parser-oracle/run --batch "$manifest" >"$scala_output"
  oracle_count=$(grep -c '^{"' "$scala_output" || true)
  if [[ "$oracle_count" != "$file_count" ]]; then
    echo "Scala oracle output count mismatch: expected $file_count, got $oracle_count" >&2
    exit 1
  fi
  python3 - "$manifest" "$scala_output" "$source_set_counts" <<'PY'
import json
import pathlib
import sys

manifest = pathlib.Path(sys.argv[1]).read_text(encoding="utf-8").split("\n")
output = pathlib.Path(sys.argv[2]).read_text(encoding="utf-8").split("\n")
if manifest and manifest[-1] == "":
    manifest.pop()
if output and output[-1] == "":
    output.pop()
counts_path = pathlib.Path(sys.argv[3])
counts = {name: [int(files), 0] for name, files in (line.split("\t") for line in counts_path.read_text(encoding="utf-8").splitlines())}
if len(manifest) != len(output):
    raise SystemExit(f"oracle output count mismatch: manifest={len(manifest)} output={len(output)}")
boundaries = []
end = 0
for name, (files, _) in counts.items():
    end += files
    boundaries.append((end, name))
for index, (entry, result) in enumerate(zip(manifest, output, strict=True)):
    path = entry.split("\t", 1)[1]
    # The manifest is emitted in source-set order; use counts rather than path names
    # so an arbitrary Scala 3 checkout directory is supported.
    name = next((name for boundary, name in boundaries if index < boundary), None)
    if name is None:
        raise SystemExit(f"could not associate oracle result with a source set: {path}")
    if json.loads(result).get("kind") == "OracleFailure":
        counts[name][1] += 1
with counts_path.open("w", encoding="utf-8", newline="\n") as result:
    for name, (files, failures) in counts.items():
        result.write(f"{name}\t{files}\t{failures}\n")
PY
  echo "Scala 3.9 parser oracle: $oracle_count files across Scala 3, Cats, Cats Effect, Kyo, and Shapeless 3"
  oracle_failures_total=$(awk -F '\t' '{ total += $3 } END { print total + 0 }' "$source_set_counts")
  oracle_args+=(--oracle-files "$oracle_count" --oracle-failures "$oracle_failures_total")
  while IFS=$'\t' read -r name count failures; do
    echo "  $name: $count files, $failures oracle failures"
    case "$name" in
      scala3)
        version=3.9.0
        revision=$scala3_revision
        repository=https://github.com/scala/scala3
        set_roots=("${scala3_roots[@]}")
        ;;
      cats)
        version=v2.13.0
        revision=$cats_revision
        repository=https://github.com/typelevel/cats
        set_roots=("${cats_roots[@]}")
        ;;
      cats-effect)
        version=v3.7.1
        revision=$cats_effect_revision
        repository=https://github.com/typelevel/cats-effect
        set_roots=("${cats_effect_roots[@]}")
        ;;
      kyo)
        version=$kyo_tag
        revision=$kyo_revision
        repository=https://github.com/getkyo/kyo
        set_roots=("${kyo_roots[@]}")
        ;;
      shapeless-3)
        version=$shapeless_tag
        revision=$shapeless_revision
        repository=https://github.com/typelevel/shapeless-3
        set_roots=("${shapeless_roots[@]}")
        ;;
    esac
    oracle_args+=(--source-set "$name@$version@$revision@$repository" --oracle-files "$count" --oracle-failures "$failures")
    for root in "${set_roots[@]}"; do
      oracle_args+=(--root "$root")
    done
  done <"$source_set_counts"
else
  echo "Scala parser oracle skipped; all five pinned source revisions are still verified"
  oracle_args=(
    --source-set "scala3@3.9.0@${scala3_revision}@https://github.com/scala/scala3"
    --root "${scala3_roots[0]}" --root "${scala3_roots[1]}"
    --source-set "cats@v2.13.0@${cats_revision}@https://github.com/typelevel/cats"
  )
  for root in "${cats_roots[@]}"; do oracle_args+=(--root "$root"); done
  oracle_args+=(--source-set "cats-effect@v3.7.1@${cats_effect_revision}@https://github.com/typelevel/cats-effect")
  for root in "${cats_effect_roots[@]}"; do oracle_args+=(--root "$root"); done
  oracle_args+=(--source-set "kyo@${kyo_tag}@${kyo_revision}@https://github.com/getkyo/kyo")
  for root in "${kyo_roots[@]}"; do oracle_args+=(--root "$root"); done
  oracle_args+=(--source-set "shapeless-3@${shapeless_tag}@${shapeless_revision}@https://github.com/typelevel/shapeless-3")
  for root in "${shapeless_roots[@]}"; do oracle_args+=(--root "$root"); done
fi

# These identify the primary source set even when oracle execution is skipped.
rust_args=(--source-version 3.9.0 --source-revision "$scala3_revision")
cargo run --quiet --locked -p dotty-parser-corpus-report -- \
  --parser-revision "$parser_revision" "${rust_args[@]}" "${oracle_args[@]}" \
  "${forwarded_args[@]}"
