#!/usr/bin/env bash
set -euo pipefail
fixture_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(CDPATH= cd -- "$fixture_dir/../../../../.." && pwd)"
scala_root="${SCALA39_ROOT:?set SCALA39_ROOT to pinned Scala 3.9.0 checkout}"
java_home="${JAVA_HOME:?set JAVA_HOME to Temurin JDK 21.0.8+9}"
maven_root="${COURSIER_MAVEN_ROOT:-$repo_root/target/coursier/v1/https/repo1.maven.org/maven2}"
scratch="${DOTTY_NESTED_RECURSIVE_ADT_TMP_ROOT:-$repo_root/target/source-nested-recursive-adt-oracle}"
expected_revision=777528f19a58e794c9954a42f433373472ec57f8
test "$(git -C "$scala_root" rev-parse HEAD)" = "$expected_revision"
grep -Fq 'JAVA_VERSION="21.0.8"' "$java_home/release"
grep -Fq 'IMPLEMENTOR_VERSION="Temurin-21.0.8+9"' "$java_home/release"
test -d "$java_home/jmods"
python3 - "$maven_root" "$fixture_dir/scala-artifacts.sha256.tsv" <<'PY'
from pathlib import Path
import hashlib, sys
root, manifest = Path(sys.argv[1]), Path(sys.argv[2])
lines = manifest.read_text().splitlines()
assert len(lines) == 8, f"expected eight pinned artifacts, found {len(lines)}"
for line in lines:
    expected, relative = line.split("\t")
    path = root / relative
    assert path.is_file() and hashlib.sha256(path.read_bytes()).hexdigest() == expected, relative
print(f"verified all {len(lines)} pinned Scala 3.9.0 artifacts")
PY
python3 - "$fixture_dir" <<'PY'
from pathlib import Path
import hashlib, sys
root = Path(sys.argv[1])
manifest = root / "source-hashes.tsv"
recorded = {}
for line in manifest.read_text().splitlines()[1:]:
    expected, relative = line.split("\t")
    recorded[relative] = expected
assert set(recorded) == {path.name for path in root.glob("*.scala")}, "source inventory changed"
for name, expected in recorded.items():
    actual = hashlib.sha256((root / name).read_bytes()).hexdigest()
    assert actual == expected, f"{name}: {actual} != {expected}"
positive = hashlib.sha256((root / "Expr.scala").read_bytes()).hexdigest()
assert positive == "f700d4e27f11365a08291ae15babc65e673eb91a0bdeee45ea5dc2cf7e8c8607", positive
print(f"verified exact positive source and {len(recorded) - 1} bounded control hashes")
PY
jar_paths=()
while IFS=$'\t' read -r digest relative; do
  test -n "$digest" && test -n "$relative"
  jar_paths+=("$maven_root/$relative")
done < "$fixture_dir/scala-artifacts.sha256.tsv"
test "${#jar_paths[@]}" -eq 8
classpath="$(IFS=:; printf '%s' "${jar_paths[*]}")"
mkdir -p "$scratch/tmp" "$scratch/classes"
cd "$fixture_dir"
"$java_home/bin/java" -XX:-UsePerfData -Xshare:off -Djava.io.tmpdir="$scratch/tmp" \
  -cp "$classpath" dotty.tools.dotc.Main -classpath "$classpath" -d "$scratch/classes" \
  -Vprint:typer -Xprint-types -Yprint-debug -Yprint-debug-owners -color:never \
  Expr.scala > "$scratch/Expr.scala39-typed-tree.txt" 2> "$scratch/Expr.compiler-stderr.txt"
python3 - "$scratch/Expr.scala39-typed-tree.txt" "$scratch/Expr.compiler-stderr.txt" "$scratch/Expr.diagnostics.txt" <<'PY'
from pathlib import Path
import sys
snapshot, stderr, diagnostics = map(Path, sys.argv[1:])
snapshot.write_text(snapshot.read_text().rstrip() + "\n")
diagnostics.write_text("".join(line.rstrip(" \t\r\n") + "\n" for line in stderr.read_text().splitlines()))
PY
diff -u "$fixture_dir/Expr.scala39-typed-tree.txt" "$scratch/Expr.scala39-typed-tree.txt"
diff -u "$fixture_dir/Expr.diagnostics.txt" "$scratch/Expr.diagnostics.txt"
python3 - "$scratch/Expr.scala39-typed-tree.txt" <<'PY'
from pathlib import Path
import sys
text = Path(sys.argv[1]).read_text()
assert "sealed trait Expr" in text
assert "final case class Add(" in text
assert text.count("[owner = class Add]val left: adt.this.Expr") == 1
assert text.count("[owner = class Add]val right: adt.this.Expr") == 1
assert text.count("[owner = class Add]def _1: adt.this.Expr") == 1
assert text.count("[owner = class Add]def _2: adt.this.Expr") == 1
assert "[owner = class Num]def _1: <root>.this.scala.Int" in text
assert "[owner = object Add$]def unapply([owner = method unapply]x$1: adt.this.Add)" in text
assert "def peelLeft(" in text and "def sum(" in text
assert text.count("Evaluator$.this.sum:") == 3
assert text.count("(<right:adt.this.Expr>):<root>.this.scala.Int") == 2
assert text.count("(<left:adt.this.Expr>):<root>.this.scala.Int") == 1
assert "adt.this.Add" in text and "adt.this.Num" in text
print("verified Scala Add/Num unapply, ordered selectors, both original roots, and three Int-valued recursive calls")
PY
matrix_output="$scratch/scala-matrix.current.tsv"
printf 'source\tclassification\n' > "$matrix_output"
while IFS=$'\t' read -r source expected; do
  test "$source" = source && continue
  output="$scratch/$source.diagnostics.txt"
  mkdir -p "$scratch/classes/$source"
  if "$java_home/bin/java" -XX:-UsePerfData -Xshare:off -Djava.io.tmpdir="$scratch/tmp" \
      -cp "$classpath" dotty.tools.dotc.Main -classpath "$classpath" \
      -d "$scratch/classes/$source" -color:never "$source.scala" > "$scratch/$source.compiler-output.txt" 2>&1; then
    if grep -Eq '[0-9]+ warning(s)? found' "$scratch/$source.compiler-output.txt"; then actual=accepted_with_warning; else actual=accepted; fi
  else
    actual=rejected
  fi
  python3 - "$scratch/$source.compiler-output.txt" "$output" <<'PY'
from pathlib import Path
import sys
source, target = map(Path, sys.argv[1:])
target.write_text("".join(line.rstrip(" \t\r\n") + "\n" for line in source.read_text().splitlines()))
PY
  printf '%s\t%s\n' "$source" "$actual" >> "$matrix_output"
  test "$actual" = "$expected" || { cat "$output" >&2; exit 1; }
  diff -u "$fixture_dir/$source.diagnostics.txt" "$output"
done < "$fixture_dir/scala-matrix.tsv"
diff -u "$fixture_dir/scala-matrix.tsv" "$matrix_output"
mkdir -p "$scratch/classes/ForeignTyped"
"$java_home/bin/java" -XX:-UsePerfData -Xshare:off -Djava.io.tmpdir="$scratch/tmp" \
  -cp "$classpath" dotty.tools.dotc.Main -classpath "$classpath" \
  -d "$scratch/classes/ForeignTyped" -Vprint:typer -Xprint-types -Yprint-debug \
  -Yprint-debug-owners -color:never ForeignSameSpelledExtractor.scala \
  > "$scratch/ForeignSameSpelledExtractor.scala39-typed-tree.txt" \
  2> "$scratch/ForeignSameSpelledExtractor.typed-stderr.txt"
python3 - "$scratch/ForeignSameSpelledExtractor.typed-stderr.txt" \
  "$scratch/ForeignSameSpelledExtractor.typed-diagnostics.txt" <<'PY'
from pathlib import Path
import sys
source, target = map(Path, sys.argv[1:])
target.write_text("".join(line.rstrip(" \t\r\n") + "\n" for line in source.read_text().splitlines()))
PY
diff -u "$fixture_dir/ForeignSameSpelledExtractor.diagnostics.txt" \
  "$scratch/ForeignSameSpelledExtractor.typed-diagnostics.txt"
python3 - "$scratch/ForeignSameSpelledExtractor.scala39-typed-tree.txt" <<'PY'
from pathlib import Path
import sys
path = Path(sys.argv[1])
path.write_text(path.read_text().rstrip() + "\n")
text = path.read_text()
assert "Foreign$.this.Add$" in text
assert "[owner = object Add$]def unapply" in text
assert "adt.this.Foreign:adt.this.Foreign$" in text
print("verified the accepted same-spelled extractor resolves through Foreign.Add's own companion")
PY
diff -u "$fixture_dir/ForeignSameSpelledExtractor.scala39-typed-tree.txt" \
  "$scratch/ForeignSameSpelledExtractor.scala39-typed-tree.txt"
python3 - "$fixture_dir/scala-matrix.tsv" "$fixture_dir/negative-cases.tsv" <<'PY'
from pathlib import Path
import sys
matrix, cases = map(lambda path: Path(path).read_text().splitlines(), sys.argv[1:])
expected = {line.split("\t")[0]: line.split("\t")[1] for line in matrix[1:]}
recorded = {line.split("\t")[0]: line.split("\t")[1] for line in cases[1:]}
assert expected == recorded, "classification matrix and case rationales differ"
assert 6 <= len(expected) <= 10, f"control matrix is not bounded: {len(expected)}"
print(f"verified {len(expected)} observed Scala control classifications and rationales")
PY
python3 - "$scratch" "$fixture_dir/output-sha256.tsv" <<'PY'
from pathlib import Path
import hashlib, sys
scratch, manifest = Path(sys.argv[1]), Path(sys.argv[2])
for line in manifest.read_text().splitlines()[1:]:
    expected, relative = line.split("\t")
    path = scratch / relative
    assert path.is_file() and hashlib.sha256(path.read_bytes()).hexdigest() == expected, relative
print("verified normalized typed-tree and diagnostic output hashes")
PY
printf 'Scala source revision: %s\n' "$expected_revision"
printf 'JDK: %s; %s\n' "$(grep '^JAVA_VERSION=' "$java_home/release")" "$(grep '^IMPLEMENTOR_VERSION=' "$java_home/release")"
printf 'Two original source roots and %s Scala control classifications match.\n' "$(($(wc -l < "$fixture_dir/scala-matrix.tsv") - 1))"
