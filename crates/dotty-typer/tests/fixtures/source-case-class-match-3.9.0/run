#!/usr/bin/env bash
set -euo pipefail
fixture_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(CDPATH= cd -- "$fixture_dir/../../../../.." && pwd)"
scala_root="${SCALA39_ROOT:?set SCALA39_ROOT to the pinned Scala checkout}"
java_home="${JAVA_HOME:?set JAVA_HOME to Temurin JDK 21.0.8+9}"
maven_root="${COURSIER_MAVEN_ROOT:-$repo_root/target/coursier/v1/https/repo1.maven.org/maven2}"
scratch="${DOTTY_CASE_CLASS_MATCH_TMP_ROOT:-$repo_root/target/source-case-class-match-oracle}"
expected_revision=777528f19a58e794c9954a42f433373472ec57f8
test "$(git -C "$scala_root" rev-parse HEAD)" = "$expected_revision"
grep -Fq 'JAVA_VERSION="21.0.8"' "$java_home/release"
grep -Fq 'IMPLEMENTOR_VERSION="Temurin-21.0.8+9"' "$java_home/release"
test -d "$java_home/jmods"
python3 - "$maven_root" "$fixture_dir/scala-artifacts.sha256.tsv" <<'PY'
from pathlib import Path
import hashlib, sys
root, manifest = Path(sys.argv[1]), Path(sys.argv[2])
for line in manifest.read_text().splitlines():
    expected, relative = line.split("\t")
    path = root / relative
    assert path.is_file() and hashlib.sha256(path.read_bytes()).hexdigest() == expected, relative
print("verified eight pinned Scala 3.9.0 artifacts")
PY
python3 - "$fixture_dir" "$fixture_dir/source-hashes.tsv" <<'PY'
from pathlib import Path
import hashlib, sys
root, manifest = Path(sys.argv[1]), Path(sys.argv[2])
for line in manifest.read_text().splitlines()[1:]:
    expected, relative = line.split("\t")
    path = root / relative
    assert path.is_file() and hashlib.sha256(path.read_bytes()).hexdigest() == expected, relative
print("verified frozen source SHA-256 manifest")
PY
jar_paths=()
while IFS= read -r line; do jar_paths+=("$maven_root/${line#*$'\t'}"); done < "$fixture_dir/scala-artifacts.sha256.tsv"
classpath="$(IFS=:; printf '%s' "${jar_paths[*]}")"
mkdir -p "$scratch/tmp" "$scratch/classes"
cd "$fixture_dir"
"$java_home/bin/java" -XX:-UsePerfData -Xshare:off -Djava.io.tmpdir="$scratch/tmp" \
  -cp "$classpath" dotty.tools.dotc.Main -classpath "$classpath" -d "$scratch/classes" \
  -Vprint:typer -Xprint-types -Yprint-debug -Yprint-debug-owners -color:never \
  Positive.scala > "$scratch/Positive.current.txt" 2> "$scratch/compiler-stderr.txt"
python3 - "$scratch/Positive.current.txt" <<'PY'
from pathlib import Path
import sys
p=Path(sys.argv[1]); p.write_text(p.read_text().rstrip()+"\n")
PY
if [[ "${UPDATE_SNAPSHOT:-0}" == 1 ]]; then
  cp "$scratch/Positive.current.txt" "$fixture_dir/Positive.scala39-typed-tree.txt"
else
  diff -u "$fixture_dir/Positive.scala39-typed-tree.txt" "$scratch/Positive.current.txt"
fi
"$java_home/bin/java" -XX:-UsePerfData -Xshare:off -Djava.io.tmpdir="$scratch/tmp" \
  -cp "$classpath" dotty.tools.dotc.Main -classpath "$classpath" \
  -d "$scratch/classes" -Vprint:typer -Xprint-types -Yprint-debug \
  -Yprint-debug-owners -color:never SameSpelledExtractor.scala \
  > "$scratch/SameSpelledExtractor.current.txt" 2> "$scratch/same-spelled-compiler-stderr.txt"
python3 - "$scratch/SameSpelledExtractor.current.txt" <<'PY'
from pathlib import Path
import sys
p=Path(sys.argv[1]); p.write_text(p.read_text().rstrip()+"\n")
PY
if [[ "${UPDATE_SNAPSHOT:-0}" == 1 ]]; then
  cp "$scratch/SameSpelledExtractor.current.txt" "$fixture_dir/SameSpelledExtractor.scala39-typed-tree.txt"
else
  diff -u "$fixture_dir/SameSpelledExtractor.scala39-typed-tree.txt" "$scratch/SameSpelledExtractor.current.txt"
fi
matrix=(
  'Wildcard.scala	accepted'
  'WrongResult.scala	rejected'
  'WrongArityZero.scala	rejected'
  'WrongArityTwo.scala	rejected'
  'WrongSelectorType.scala	accepted_with_warning'
  'WrongConstructorType.scala	rejected'
  'SameSpelledExtractor.scala	accepted_with_warning'
  'ExplicitCompanion.scala	accepted'
  'ExplicitUnapplyOverload.scala	accepted'
  'ExplicitUnapplyReuse.scala	accepted_with_warning'
  'ExplicitUnapplyWrongResult.scala	rejected'
  'PackageAliasUnapply.scala	accepted_with_warning'
  'ImportedAliasUnapply.scala	accepted_with_warning'
  'CompanionAliasUnapply.scala	accepted_with_warning'
  'NonCaseControl.scala	accepted'
)
matrix_output="$scratch/matrix.tsv"
: > "$matrix_output"
for item in "${matrix[@]}"; do
  source="${item%%$'\t'*}"
  expected="${item#*$'\t'}"
  output="$scratch/${source%.scala}.diagnostic.txt"
  mkdir -p "$scratch/classes/${source%.scala}"
  if "$java_home/bin/java" -XX:-UsePerfData -Xshare:off -Djava.io.tmpdir="$scratch/tmp" \
      -cp "$classpath" dotty.tools.dotc.Main -classpath "$classpath" \
      -d "$scratch/classes/${source%.scala}" -color:never "$source" > "$output" 2>&1; then
    if grep -Fq 'warning found' "$output"; then actual=accepted_with_warning; else actual=accepted; fi
  else
    actual=rejected
  fi
  printf '%s\t%s\n' "${source%.scala}" "$actual" >> "$matrix_output"
  test "$actual" = "$expected" || { cat "$output" >&2; exit 1; }
done
if [[ "${UPDATE_SNAPSHOT:-0}" == 1 ]]; then
  cp "$matrix_output" "$fixture_dir/scala-matrix.tsv"
else
  diff -u "$fixture_dir/scala-matrix.tsv" "$matrix_output"
fi
printf 'Scala 3.9.0 source revision: %s\n' "$expected_revision"
printf 'JDK: %s\n' "$(grep '^JAVA_VERSION=' "$java_home/release")"
printf 'Positive whole-source typer snapshot matches.\n'
printf 'Distinct same-spelled extractor owner snapshot matches.\n'
printf 'Bounded extractor acceptance matrix matches.\n'
